{% if section.settings.enabled %}
  <div class="nf-bottom-space" aria-hidden="true"></div>
  <nav class="nf-bottom-nav" aria-label="{{ section.settings.nav_label | escape }}" style="--nf-nav-bg: {{ section.settings.background }}; --nf-nav-active: {{ section.settings.accent }}; --nf-nav-text: {{ section.settings.text_color }};">
    <a href="{{ routes.root_url }}" class="nf-bottom-nav__item" {% if request.page_type == 'index' %}aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10H15v-6H9v6H3Z"/></svg>
      <span>{{ section.settings.home_label | escape }}</span>
    </a>
    <a href="{{ section.settings.category_link | default: routes.collections_url }}" class="nf-bottom-nav__item" {% if request.page_type == 'list-collections' or request.page_type == 'collection' %}aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      <span>{{ section.settings.category_label | escape }}</span>
    </a>
    <button type="button" class="nf-bottom-nav__item" data-nectar-wishlist-trigger aria-controls="NectarWishlistDrawer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0l-1 1-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg>
      <span>{{ section.settings.wishlist_label | escape }}</span>
      <span class="nf-bottom-nav__badge" data-nectar-wishlist-count style="display:none">0</span>
    </button>
    <a href="{{ routes.account_url }}" class="nf-bottom-nav__item" {% if request.page_type contains 'customers' %}aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>
      <span>{{ section.settings.account_label | escape }}</span>
    </a>
    <a href="{{ routes.cart_url }}" class="nf-bottom-nav__item" {% if request.page_type == 'cart' %}aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
      <span>{{ section.settings.cart_label | escape }}</span>
      <span class="nf-bottom-nav__badge" data-nf-cart-count>{{ cart.item_count }}</span>
    </a>
  </nav>
{% endif %}
{% stylesheet %}
  .nf-bottom-nav, .nf-bottom-space { display: none; }
  @media (max-width: 749px) {
    .nf-bottom-space { display: block; height: calc(66px + env(safe-area-inset-bottom, 0px)); flex-shrink: 0; }
    .nf-bottom-nav { position: fixed; bottom: 0; inset-inline: 0; z-index: 90; display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); padding: 7px 8px calc(7px + env(safe-area-inset-bottom,0px)); background: var(--nf-nav-bg); border-top: 1px solid #dfe8e2; box-shadow: 0 -3px 18px rgb(13 59 43 / 6%); }
    .nf-bottom-nav__item { position: relative; min-width: 0; min-height: 50px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; margin: 0; padding: 4px 2px; border: 0; background: transparent; color: var(--nf-nav-text); font: 500 11px/1.2 Arial,Helvetica,sans-serif; text-decoration: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
    .nf-bottom-nav__item svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .nf-bottom-nav__item[aria-current="page"] { color: var(--nf-nav-active); font-weight: 700; }
    .nf-bottom-nav__item:focus-visible { outline: 2px solid var(--nf-nav-active); outline-offset: -2px; border-radius: 5px; }
    .nf-bottom-nav__badge { position: absolute; top: 0; left: calc(50% + 5px); min-width: 16px; height: 16px; padding: 0 4px; border-radius: 20px; display: grid; place-items: center; background: var(--nf-nav-active); color: white; font-size: 10px; line-height: 1; }
    body:has(.nf-bottom-nav) .nectar-sticky-atc { bottom: calc(66px + env(safe-area-inset-bottom,0px)); }
  }
{% endstylesheet %}
{% javascript %}
  document.addEventListener('keydown', function(event) {
    const tab = event.target.closest('[data-nectar-tab]');
    if (!tab || !['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) return;
    const tabs = Array.from(tab.closest('[role="tablist"]').querySelectorAll('[data-nectar-tab]'));
    let index = tabs.indexOf(tab);
    if (event.key === 'Home') index = 0;
    else if (event.key === 'End') index = tabs.length - 1;
    else index = (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
    event.preventDefault(); tabs[index].click(); tabs[index].focus();
  });
  function nfSyncBottomCount() {
    const badge = document.querySelector('.nectar-header__cart-badge:not(.nectar-wishlist-badge)');
    if (!badge) return;
    document.querySelectorAll('[data-nf-cart-count]').forEach(function(item) { item.textContent = badge.textContent.trim(); });
  }
  document.addEventListener('DOMContentLoaded', function() {
    const badge = document.querySelector('.nectar-header__cart-badge:not(.nectar-wishlist-badge)');
    if (badge) new MutationObserver(nfSyncBottomCount).observe(badge, {childList:true, subtree:true, characterData:true});
    nfSyncBottomCount();
  });
{% endjavascript %}
{% schema %}
{
  "name": "Mobile bottom navigation",
  "settings": [
    {"type":"checkbox","id":"enabled","label":"Show mobile bottom navigation","default":true},
    {"type":"text","id":"nav_label","label":"Navigation accessibility label","default":"Mobile navigation"},
    {"type":"text","id":"home_label","label":"Home label","default":"Home"},
    {"type":"text","id":"category_label","label":"Categories label","default":"Categories"},
    {"type":"url","id":"category_link","label":"Categories link"},
    {"type":"text","id":"wishlist_label","label":"Wishlist label","default":"Wishlist"},
    {"type":"text","id":"account_label","label":"Account label","default":"Account"},
    {"type":"text","id":"cart_label","label":"Cart label","default":"Cart"},
    {"type":"color","id":"background","label":"Background","default":"#ffffff"},
    {"type":"color","id":"accent","label":"Active icon and badge","default":"#0a8754"},
    {"type":"color","id":"text_color","label":"Icon and label color","default":"#36443e"}
  ]
}
{% endschema %}
