{{ 'nf-pdp.css' | asset_url | stylesheet_tag }}
{% assign entries = product.metafields.custom.pdp_reviews.value %}
{% if entries != blank or request.design_mode %}
<section class="nf-pdp-section nf-pdp-section--reviews" style="--nf-section-bg:{{ section.settings.background }};--nf-section-accent:{{ section.settings.accent }};--nf-section-padding:{{ section.settings.padding }}px">
<div class="nf-pdp-shell">
<header class="nf-pdp-section-heading"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.subheading | escape }}</p></header><div class="nf-pdp-review-grid">{% if product.metafields.reviews.rating.value != blank %}<div class="nf-pdp-review-summary"><strong>{{ product.metafields.reviews.rating.value.rating }}</strong><span aria-hidden="true">★★★★★</span><p>{{ section.settings.based_label | escape }} {{ product.metafields.reviews.rating_count | default: 0 }} {{ section.settings.reviews_label | escape }}</p></div>{% endif %}{% for item in entries limit: section.settings.max_items %}<article class="nf-pdp-review"><span class="nf-pdp-quote" aria-hidden="true">“</span>{% if item.rating.value != blank %}<span class="nf-pdp-stars" aria-label="{{ item.rating.value }} / 5">{% for star in (1..item.rating.value) %}★{% endfor %}</span>{% endif %}<p>{{ item.text.value | escape }}</p><footer><span>{{ item.initial.value | default: item.author.value | slice: 0, 2 | upcase | escape }}</span><strong>{{ item.author.value | escape }}</strong></footer></article>{% endfor %}</div>{% if section.settings.review_link != blank %}<a class="nf-pdp-review-link" href="{{ section.settings.review_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}{% if entries == blank and request.design_mode %}<p class="nf-pdp-editor">Connect product metafield custom.pdp_reviews to show this section. Add product-specific entries in the product editor.</p>{% endif %}</div></section>{% endif %}
{% schema %}
{"name": "Nectar Reviews", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews"}, {"type": "text", "id": "subheading", "label": "Subheading"}, {"type": "color", "id": "background", "label": "Background", "default": "#ffffff"}, {"type": "color", "id": "accent", "label": "Accent", "default": "#f7c711"}, {"type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 60}, {"type": "url", "id": "review_link", "label": "All reviews link"}, {"type": "text", "id": "button_label", "label": "Button label", "default": "Read all reviews"}, {"type": "text", "id": "based_label", "label": "Based on label", "default": "Based on"}, {"type": "text", "id": "reviews_label", "label": "Reviews label", "default": "reviews"}, {"type": "range", "id": "max_items", "label": "Maximum items", "min": 1, "max": 12, "step": 1, "default": 2}], "presets": [{"name": "Nectar Reviews"}]}
{% endschema %}