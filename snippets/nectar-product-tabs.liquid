  <div class="nectar-benefit-item">
    <div class="nectar-benefit-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a9 9 0 0 0-7 9.5c0 4.2 3.3 7.5 7 7.5s7-3.3 7-7.5A9 9 0 0 0 12 3z"/>
