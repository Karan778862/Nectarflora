<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {{ 'nectar-product.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    #MainProduct-{{ section.id }} {
      --product-accent-color: {{ product.metafields.custom.color_hex | default: product.metafields.custom.color | default: '#0D3B2B' }};
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'nectar-product.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
    <div class="page-width">
      <!-- Breadcrumbs -->
      {% render 'nectar-breadcrumbs', product: product %}

      <div class="nectar-pdp-layout product">
        
        <!-- Left: Product Media Gallery (Always renders 9% badge, 5 thumbnails, floating 10% tab) -->
        <div class="product__media-wrapper">
          {% render 'nectar-product-media-gallery', product: product, variant_images: variant_images %}
        </div>

        <!-- Right: Product Information Blocks -->
        <div class="product__info-wrapper">
          <section
            id="ProductInfo-{{ section.id }}"
            class="product__info-container"
          >
            {%- assign product_form_id = 'product-form-' | append: section.id -%}
            {%- assign nectar_tabs_rendered = false -%}

            {%- assign has_custom_subtitle = false -%}
            {%- assign has_custom_rating = false -%}
            {%- assign has_custom_tabs = false -%}
            {%- assign has_custom_claims = false -%}
            {%- assign has_custom_benefits = false -%}
            {%- assign has_custom_price = false -%}
            {%- assign has_custom_offers = false -%}
            {%- assign has_custom_bundles = false -%}
            {%- assign has_custom_buy = false -%}
            {%- assign has_custom_trust = false -%}
            {%- assign has_custom_lab = false -%}
            {%- assign has_custom_nutritionist = false -%}

            {%- for b in section.blocks -%}
              {%- case b.type -%}
                {%- when 'subtitle' -%}{%- assign has_custom_subtitle = true -%}
                {%- when 'nectar_rating', 'rating' -%}{%- assign has_custom_rating = true -%}
                {%- when 'product_tabs' -%}{%- assign has_custom_tabs = true -%}
                {%- when 'clinical_claims' -%}{%- assign has_custom_claims = true -%}
                {%- when 'key_benefits' -%}{%- assign has_custom_benefits = true -%}
                {%- when 'nectar_price' -%}{%- assign has_custom_price = true -%}
                {%- when 'available_offers' -%}{%- assign has_custom_offers = true -%}
                {%- when 'bundle_selector' -%}{%- assign has_custom_bundles = true -%}
                {%- when 'nectar_buy_buttons' -%}{%- assign has_custom_buy = true -%}
                {%- when 'trust_badges' -%}{%- assign has_custom_trust = true -%}
                {%- when 'lab_tested' -%}{%- assign has_custom_lab = true -%}
                {%- when 'nutritionist_badge' -%}{%- assign has_custom_nutritionist = true -%}
              {%- endcase -%}
            {%- endfor -%}

            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}

                {%- when 'custom_liquid' -%}
                  <div {{ block.shopify_attributes }}>
                    {{ block.settings.custom_liquid }}
                  </div>

                {%- when 'text' -%}
                  <p
                    class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.text -}}
                  </p>

                {%- when 'title' -%}
                  <div class="nectar-block-title-wrap" {{ block.shopify_attributes }}>
                    <h1 class="nectar-product-title">{{ product.title | escape }}</h1>
                    {%- unless has_custom_subtitle -%}
                      {%- assign sub_text = product.metafields.custom.subtitle.value | default: product.metafields.custom.subtitle -%}
                      {%- if sub_text == blank -%}
                        {%- assign sub_text = 'Advance Skin Wellness Formula' -%}
                      {%- endif -%}
                      <div class="nectar-product-subtitle">{{ sub_text }}</div>
                    {%- endunless -%}
                    {%- unless has_custom_rating -%}
                      <div class="nectar-product-rating-wrap">
                        <div class="nectar-rating-stars">★★★★★</div>
                        <span class="nectar-rating-score">4.6/5</span>
                        <span class="nectar-rating-count">(128)</span>
                      </div>
                    {%- endunless -%}
                  </div>

                  {%- comment -%} Always guarantee 5 tabs, disclaimer & 6 benefits render directly below title {%- endcomment -%}
                  {%- if nectar_tabs_rendered == false and has_custom_tabs == false -%}
                    {%- assign nectar_tabs_rendered = true -%}
                    {% render 'nectar-product-blocks', block: block, product: product, section: section, forced_type: 'product_tabs' %}
                    <div class="nectar-clinical-disclaimer">
                      Claims based on clinically studied ingredients, not the product.
                    </div>
                    <div class="nectar-benefits-grid">
                      <div class="nectar-benefit-item">
                        <div class="nectar-benefit-icon">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                          </svg>
                        </div>
                        <div class="nectar-benefit-text">Improves Skin<br>Brightness¹</div>
                      </div>
                      <div class="nectar-benefit-item">
                        <div class="nectar-benefit-icon">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M5 22h14M5 2h14M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/>
                          </svg>
                        </div>
                        <div class="nectar-benefit-text">Anti-Ageing<br>Support²</div>
                      </div>
                      <div class="nectar-benefit-item">
                        <div class="nectar-benefit-icon">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                          </svg>
                        </div>
                        <div class="nectar-benefit-text">Supports Cellular<br>Health³</div>
                      </div>
                      <div class="nectar-benefit-item">
                        <div class="nectar-benefit-icon">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                            <line x1="9" y1="9" x2="9.01" y2="9"/>
                            <line x1="15" y1="9" x2="15.01" y2="9"/>
                          </svg>
                        </div>
                        <div class="nectar-benefit-text">Helps Reduce<br>Pigmentation⁴</div>
                      </div>
                      <div class="nectar-benefit-item">
                        <div class="nectar-benefit-icon">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                          </svg>
                        </div>
                        <div class="nectar-benefit-text">Deep Skin<br>Hydration⁵</div>
                      </div>
                      <div class="nectar-benefit-item">
                        <div class="nectar-benefit-icon">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                          </svg>
                        </div>
                        <div class="nectar-benefit-text">Antioxidant<br>Protection⁶</div>
                      </div>
                    </div>
                  {%- endif -%}

                {%- when 'subtitle', 'nectar_rating', 'rating', 'product_tabs', 'clinical_claims', 'key_benefits', 'nectar_price', 'available_offers', 'bundle_selector', 'nectar_buy_buttons', 'trust_badges', 'lab_tested', 'nutritionist_badge' -%}
                  {%- if block.type == 'product_tabs' -%}{%- assign nectar_tabs_rendered = true -%}{%- endif -%}
                  {% render 'nectar-product-blocks', block: block, product: product, section: section %}

                {%- when 'description' -%}
                  {%- if has_custom_tabs -%}
                    <div class="product__description rte" {{ block.shopify_attributes }}>
                      {{ product.description }}
                    </div>
                  {%- elsif nectar_tabs_rendered == false -%}
                    {%- assign nectar_tabs_rendered = true -%}
                    {% render 'nectar-product-blocks', block: block, product: product, section: section %}
                  {%- endif -%}

                {%- when 'price' -%}

                  {%- unless has_custom_price -%}
                    {% render 'nectar-product-blocks', block: block, product: product, section: section %}
                    {%- unless has_custom_offers -%}
                      <div class="nectar-offers-box">
                        <div class="nectar-offers-header">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 17px; height: 17px;">
                            <polyline points="20 12 20 22 4 22 4 12"/>
                            <rect x="2" y="7" width="20" height="5"/>
                            <line x1="12" y1="22" x2="12" y2="7"/>
                            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
                            <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
                          </svg>
                          <span>Available Offers</span>
                        </div>
                        <div class="nectar-offers-list">
                          <div class="nectar-offer-item">
                            <span class="nectar-offer-badge" data-coupon="BUY2GET1" title="Click to copy">BUY2GET1</span>
                            <span>Buy any 2, get 1 free</span>
                          </div>
                          <div class="nectar-offer-item">
                            <span class="nectar-offer-badge" data-coupon="FIRST10" title="Click to copy">FIRST10</span>
                            <span>Extra 10% off on your first order</span>
                          </div>
                          <div class="nectar-offer-item">
                            <span class="nectar-offer-badge" data-coupon="FREESHIP" title="Click to copy">FREESHIP</span>
                            <span>Free shipping on orders above ₹499</span>
                          </div>
                        </div>
                      </div>
                    {%- endunless -%}
                  {%- endunless -%}

                {%- when 'quantity_selector', 'variant_picker' -%}
                  {%- unless has_custom_bundles -%}
                    {% render 'nectar-product-blocks', block: block, product: product, section: section %}
                  {%- endunless -%}

                {%- when 'buy_buttons' -%}
                  {%- unless has_custom_buy -%}
                    {% render 'nectar-product-blocks', block: block, product: product, section: section %}
                    {%- unless has_custom_trust -%}
                      <div class="nectar-trust-badges-row">
                        <div class="nectar-trust-badge-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>Free Shipping</span></div>
                        <div class="nectar-trust-badge-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>Cash on Delivery</span></div>
                        <div class="nectar-trust-badge-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>100% Vegan Capsule</span></div>
                      </div>
                    {%- endunless -%}
                    {%- unless has_custom_lab -%}
                      <div class="nectar-lab-tested-banner" id="lab-test">
                        <div class="nectar-lab-left">
                          <div class="nectar-qr-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></div>
                          <div class="nectar-lab-info">
                            <div class="nectar-lab-title">Third-party Lab Tested</div>
                            <div class="nectar-lab-subtitle">Scan the QR on your pack to view the batch report</div>
                          </div>
                        </div>
                        <button type="button" class="nectar-lab-btn" onclick="alert('Viewing Batch Certificate: 100% Purity & Safety Passed');">View Report</button>
                      </div>
                    {%- endunless -%}
                    {%- unless has_custom_nutritionist -%}
                      <a href="https://wa.me/" class="nectar-nutritionist-pill" target="_blank" rel="noopener">
                        <div class="nectar-nutritionist-avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
                        <div class="nectar-nutritionist-info">
                          <div class="nectar-nutritionist-title">Talk to a Nutritionist</div>
                          <div class="nectar-nutritionist-sub"><span class="nectar-online-dot"></span><span>Free • Online now</span></div>
                        </div>
                      </a>
                    {%- endunless -%}
                  {%- endunless -%}

                {%- when 'share' -%}
                  <div class="share-button quick-add-hidden" {{ block.shopify_attributes }}>
                    {% assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin %}
                    {% render 'share-button', block: block, share_link: share_url %}
                  </div>

              {%- endcase -%}
            {%- endfor -%}
          </section>
        </div>
      </div>

      {%- liquid
        if product.selected_or_first_available_variant.featured_media
          assign seo_media = product.selected_or_first_available_variant.featured_media
        else
          assign seo_media = product.featured_media
        endif
      -%}

      <script type="application/ld+json">
        {{ product | structured_data }}
      </script>
    </div>
  </product-component>
</product-info>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "subtitle",
      "name": "Product Subtitle / Tagline",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Subtitle Text",
          "default": "Advance Skin Wellness Formula",
          "info": "Falls back to custom.subtitle metafield if left blank"
        }
      ]
    },
    {
      "type": "nectar_rating",
      "name": "Rating & Reviews",
      "settings": [
        {
          "type": "text",
          "id": "score",
          "label": "Rating Score",
          "default": "4.6"
        },
        {
          "type": "text",
          "id": "reviews_count",
          "label": "Reviews Count",
          "default": "128"
        }
      ]
    },
    {
      "type": "product_tabs",
      "name": "Product Tabs (Accordion/Tabs)",
      "settings": [
        {
          "type": "text",
          "id": "tab_1_title",
          "label": "Tab 1 Title",
          "default": "Description"
        },
        {
          "type": "text",
          "id": "tab_2_title",
          "label": "Tab 2 Title",
          "default": "Ingredients"
        },
        {
          "type": "text",
          "id": "tab_3_title",
          "label": "Tab 3 Title",
          "default": "How to take"
        },
        {
          "type": "text",
          "id": "tab_4_title",
          "label": "Tab 4 Title",
          "default": "FAQ"
        },
        {
          "type": "text",
          "id": "tab_5_title",
          "label": "Tab 5 Title",
          "default": "Lab Reports"
        }
      ]
    },
    {
      "type": "clinical_claims",
      "name": "Clinical Claims Note",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Disclaimer Text",
          "default": "Claims based on clinically studied ingredients, not the product."
        }
      ]
    },
    {
      "type": "key_benefits",
      "name": "Key Benefits (6 Icons)",
      "settings": []
    },
    {
      "type": "nectar_price",
      "name": "Price (Custom Layout)",
      "settings": []
    },
    {
      "type": "available_offers",
      "name": "Available Offers Box",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Available Offers"
        },
        {
          "type": "text",
          "id": "offer_1_text",
          "label": "Offer 1",
          "default": "Buy any 2, get 1 free"
        },
        {
          "type": "text",
          "id": "offer_2_text",
          "label": "Offer 2",
          "default": "Extra 10% off on your first order"
        },
        {
          "type": "text",
          "id": "offer_3_text",
          "label": "Offer 3",
          "default": "Free shipping on orders above ₹499"
        }
      ]
    },
    {
      "type": "bundle_selector",
      "name": "Select Option (Bundle Cards)",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Select Option"
        }
      ]
    },
    {
      "type": "nectar_buy_buttons",
      "name": "Buy Buttons (Add to Cart + Buy Now)",
      "settings": [
        {
          "type": "text",
          "id": "add_to_cart_label",
          "label": "Add to Cart Label",
          "default": "Add to cart"
        },
        {
          "type": "text",
          "id": "buy_now_label",
          "label": "Buy Now Label",
          "default": "BUY NOW"
        }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust Badges (Shipping, COD, Vegan)",
      "settings": []
    },
    {
      "type": "lab_tested",
      "name": "Third-party Lab Tested Banner",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Third-party Lab Tested"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Scan the QR on your pack to view the batch report"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button Label",
          "default": "View Report"
        }
      ]
    },
    {
      "type": "nutritionist_badge",
      "name": "Talk to a Nutritionist Pill",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Talk to a Nutritionist"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Free • Online now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "WhatsApp or Consultation Link"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.main-product.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
