{{ 'nf-pdp.css' | asset_url | stylesheet_tag }}
{% assign entries = product.metafields.custom.pdp_faqs.value %}
{% if entries != blank or request.design_mode %}
<section class="nf-pdp-section nf-pdp-section--faqs" style="--nf-section-bg:{{ section.settings.background }};--nf-section-accent:{{ section.settings.accent }};--nf-section-padding:{{ section.settings.padding }}px">
<div class="nf-pdp-shell">
<header class="nf-pdp-section-heading"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.subheading | escape }}</p></header><div class="nf-pdp-faq-list">{% for item in entries limit: section.settings.max_items %}<details {% if forloop.first and section.settings.open_first %}open{% endif %}><summary>{{ item.title.value | escape }}<span aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m6 8 4 4 4-4"/></svg></span></summary><p>{{ item.text.value | escape | newline_to_br }}</p></details>{% endfor %}</div>{% if section.settings.contact_link != blank %}<p class="nf-pdp-contact"><span>{{ section.settings.contact_prompt | escape }}</span> <a href="{{ section.settings.contact_link }}">{{ section.settings.contact_label | escape }} →</a></p>{% endif %}{% if entries == blank and request.design_mode %}<p class="nf-pdp-editor">Connect product metafield custom.pdp_faqs to show this section. Add product-specific entries in the product editor.</p>{% endif %}</div></section>{% endif %}
{% schema %}
{"name": "Nectar Faqs", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions"}, {"type": "text", "id": "subheading", "label": "Subheading"}, {"type": "color", "id": "background", "label": "Background", "default": "#f7f8f3"}, {"type": "color", "id": "accent", "label": "Accent", "default": "#f7c711"}, {"type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 60}, {"type": "checkbox", "id": "open_first", "label": "Open first answer", "default": true}, {"type": "url", "id": "contact_link", "label": "Nutritionist / help link"}, {"type": "text", "id": "contact_prompt", "label": "Help prompt", "default": "Still have questions?"}, {"type": "text", "id": "contact_label", "label": "Help label", "default": "Talk to our team"}, {"type": "range", "id": "max_items", "label": "Maximum items", "min": 1, "max": 12, "step": 1, "default": 12}], "presets": [{"name": "Nectar Faqs"}]}
{% endschema %}