{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Shop by Category",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Explore our full range, category by category",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 4,
      "label": "Products to show per tab"
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel Slider"
        },
        {
          "value": "grid",
          "label": "Grid Layout"
        }
      ],
      "default": "grid",
      "label": "Desktop Layout"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "options": [
        {
          "value": "carousel",
          "label": "Horizontal Swipe Carousel"
        },
        {
          "value": "grid_2",
          "label": "2 Columns Grid"
        }
      ],
      "default": "carousel",
      "label": "Mobile Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category_tab",
      "name": "Category Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Category"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        {
          "type": "category_tab",
          "settings": {
            "title": "Bestsellers"
          }
        },
        {
          "type": "category_tab",
          "settings": {
            "title": "Skin"
          }
        },
        {
          "type": "category_tab",
          "settings": {
            "title": "Hair"
          }
        },
        {
          "type": "category_tab",
          "settings": {
            "title": "Sleep & Stress"
          }
        },
        {
          "type": "category_tab",
          "settings": {
            "title": "Liver & Digestion"
          }
        },
        {
          "type": "category_tab",
          "settings": {
            "title": "Brain"
          }
        },
        {
          "type": "category_tab",
          "settings": {
            "title": "Women Health"
          }
        }
      ]
    }
  ]
}
{% endschema %}
