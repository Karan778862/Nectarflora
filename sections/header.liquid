<!-- Sliding Side Drawer for Mobile/Tablet -->
<div class="nectar-drawer-backdrop" aria-hidden="true"></div>
<aside class="nectar-drawer" aria-label="Mobile Navigation" role="dialog" aria-modal="true">
  <div class="nectar-drawer__header">
    <span class="nectar-header__logo-text">
      <span class="logo-orange">Nectar</span><span class="logo-green">flora</span><sup class="logo-tm">™</sup>
    </span>
    <button type="button" class="nectar-drawer__close-btn" aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <div class="nectar-drawer__content">
    <ul class="nectar-drawer__menu" role="list">
      {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
        {%- for link in linklists[section.settings.menu].links -%}
          {%- assign megamenu_block = nil -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'mega_menu' -%}
              {%- assign target_title = block.settings.menu_item_title | downcase | strip -%}
              {%- assign link_title = link.title | downcase | strip -%}
              {%- if target_title == link_title -%}
                {%- assign megamenu_block = block -%}
                {%- break -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          <li class="nectar-drawer__item">
            <div class="nectar-drawer__link-row">
              <a href="{{ link.url }}" class="nectar-drawer__link{% if link.active %} is-active{% endif %}">
                {{ link.title | escape }}
              </a>
              {%- if megamenu_block != nil or link.links != blank -%}
                <button type="button" class="nectar-drawer__toggle-btn" aria-label="Expand submenu">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
              {%- endif -%}
            </div>
            {%- if megamenu_block != nil or link.links != blank -%}
              <div class="nectar-drawer__subcontent">
                <ul class="nectar-drawer__sublist" role="list">
                  {%- if link.links.size > 0 -%}
                    {%- for childlink in link.links -%}
                      <li>
                        <a href="{{ childlink.url }}" class="nectar-drawer__sublink">{{ childlink.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  {%- else -%}
                    <li><a href="/collections/all" class="nectar-drawer__sublink">Immunity & Defense</a></li>
                    <li><a href="/collections/all" class="nectar-drawer__sublink">Daily Wellness</a></li>
                    <li><a href="/collections/all" class="nectar-drawer__sublink">Skin & Hair Care</a></li>
                  {%- endif -%}
                </ul>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        <li class="nectar-drawer__item"><a href="{{ routes.root_url }}" class="nectar-drawer__link is-active">Home</a></li>
        <li class="nectar-drawer__item"><a href="/collections/all" class="nectar-drawer__link">Product by Benefits</a></li>
        <li class="nectar-drawer__item"><a href="/collections" class="nectar-drawer__link">Product by Category</a></li>
        <li class="nectar-drawer__item"><a href="/pages/free-consultation" class="nectar-drawer__link">Free Consultation</a></li>
        <li class="nectar-drawer__item"><a href="/pages/about-us" class="nectar-drawer__link">About Us</a></li>
        <li class="nectar-drawer__item"><a href="/blogs/news" class="nectar-drawer__link">Blogs</a></li>
      {%- endif -%}
    </ul>
  </div>
  <div class="nectar-drawer__footer">
    {%- if section.settings.show_wishlist -%}
      <a href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" class="nectar-drawer__footer-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        Wishlist
      </a>
    {%- endif -%}
    {%- if section.settings.show_account -%}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="nectar-drawer__footer-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        {% if customer %}{{ customer.name | default: 'My Account' }}{% else %}Login / Register{% endif %}
      </a>
    {%- endif -%}
  </div>
</aside>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: 'scheme-1', desktop_menu_type: 'dropdown' -%}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

