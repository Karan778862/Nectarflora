{{ 'nectar-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nectar-header.js' | asset_url }}" defer="defer"></script>

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  :root {
    --nectar-orange: {{ section.settings.logo_orange_color | default: '#EE5A24' }};
    --nectar-green: {{ section.settings.logo_green_color | default: '#0A8754' }};
    --nectar-subnav-bg: {{ section.settings.subnav_bg_color | default: '#EAF5EE' }};
    --nectar-top-strip-color: {{ section.settings.top_strip_color | default: '#0E3D2F' }};
    --nectar-header-bg: {{ section.settings.header_bg_color | default: '#FFFFFF' }};
  }

  .nectar-header__main-row {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .nectar-subnav__link {
    font-size: {{ section.settings.menu_font_size }}px;
    color: {{ section.settings.menu_text_color }};
  }

  .nectar-subnav__item.is-active .nectar-subnav__link,
  .nectar-subnav__link.is-active,
  .nectar-subnav__link:hover {
    color: {{ section.settings.menu_active_color }};
  }

  .nectar-header__cart-badge {
    background-color: {{ section.settings.cart_badge_color }};
    color: {{ section.settings.cart_badge_text_color }};
  }
{%- endstyle -%}

<div class="nectar-header-wrapper{% if section.settings.enable_sticky_header %} is-sticky{% endif %}" id="NectarHeaderWrapper">
  {%- if section.settings.show_top_strip -%}
    <div class="nectar-top-strip" style="height: {{ section.settings.top_strip_height }}px;"></div>
  {%- endif -%}

  <!-- Main Top Bar -->
  <header class="nectar-header__main-row" role="banner">
    <!-- Left: Kebab Menu Button + Logo -->
    <div class="nectar-header__left">
      <button
        type="button"
        class="nectar-header__kebab-btn"
        aria-label="{{ 'sections.header.menu' | t | default: 'Open Menu' }}"
        title="Open Menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <circle cx="12" cy="4.5" r="2.2" />
          <circle cx="12" cy="12" r="2.2" />
          <circle cx="12" cy="19.5" r="2.2" />
        </svg>
      </button>

      {%- if request.page_type == 'index' -%}
        <h1 class="nectar-header__heading" style="margin: 0; font-size: 1rem;">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="nectar-header__logo-link">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
          {%- assign logo_w = settings.logo_width | default: 90 -%}
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              class: 'nectar-header__logo-img',
              style: 'max-width: ' | append: logo_w | append: 'px; width: ' | append: logo_w | append: 'px;',
              alt: logo_alt,
              preload: true
          }}
        {%- else -%}
          <span class="nectar-header__logo-text">
            <span class="logo-orange">Nectar</span><span class="logo-green">flora</span><sup class="logo-tm">™</sup>
          </span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    </div>

    <!-- Center: Search Pill Input -->
    {%- if section.settings.show_search -%}
      <div class="nectar-header__center">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="nectar-header__search-form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <div class="nectar-header__search-form">
        {%- endif -%}
          <form action="{{ routes.search_url }}" method="get" role="search">
            <div class="nectar-header__search-pill">
              <span class="nectar-header__search-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </span>
              <input
                type="search"
                name="q"
                class="nectar-header__search-input"
                value="{{ search.terms | escape }}"
                placeholder="{{ section.settings.search_placeholder | default: 'Search for nutrition, skin, hair...' }}"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                aria-label="{{ section.settings.search_placeholder | default: 'Search for nutrition, skin, hair...' }}"
              >
              <input type="hidden" name="options[prefix]" value="last">
              <button type="reset" class="nectar-header__search-reset hidden" aria-label="{{ 'general.search.reset' | t | default: 'Clear search' }}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
            {%- if settings.predictive_search_enabled -%}
              <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
                {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
              </div>
              <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
            {%- endif -%}
          </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Right: Action Icons (Wishlist, Login, Cart) -->
    <div class="nectar-header__right">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}

      {%- if section.settings.show_wishlist -%}
        <a href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" class="nectar-header__action-link nectar-header__wishlist" aria-label="Wishlist" title="Wishlist">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.show_account -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="nectar-header__action-link nectar-header__login" aria-label="Customer Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span class="nectar-header__login-text">
            {% if customer %}
              {{ customer.first_name | default: 'ACCOUNT' | upcase }}
            {% else %}
              {{ section.settings.login_text | default: 'LOGIN' }}
            {% endif %}
          </span>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="nectar-header__action-link nectar-header__cart" id="cart-icon-bubble" aria-label="{{ 'templates.cart.cart' | t }}">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="nectar-header__cart-text">{{ section.settings.cart_text | default: 'Cart' }}</span>
        <span class="nectar-header__cart-badge" data-count="{{ cart.item_count }}">
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </header>

  <!-- Sub-Navigation Bar with Mega Menu Support -->
  <nav class="nectar-subnav" aria-label="Main Navigation">
    <div class="nectar-subnav__container">
      <ul class="nectar-subnav__menu" role="list">
        {%- if section.settings.use_complete_nectar_menu == false and section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
          {%- for link in linklists[section.settings.menu].links -%}
            {%- assign is_active = false -%}
            {%- if link.active or forloop.first and request.path == routes.root_url -%}
              {%- assign is_active = true -%}
            {%- endif -%}

            {%- assign megamenu_block = nil -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'mega_menu' -%}
                {%- assign target_title = block.settings.menu_item_title | downcase | strip -%}
                {%- assign link_title = link.title | downcase | strip -%}
                {%- if target_title == link_title -%}
                  {%- assign megamenu_block = block -%}
                  {%- break -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            <li class="nectar-subnav__item{% if is_active %} is-active{% endif %}{% if megamenu_block != nil %} has-megamenu{% elsif link.links != blank %} has-dropdown{% endif %}" {{ megamenu_block.shopify_attributes }}>
              <a href="{{ link.url }}" class="nectar-subnav__link{% if is_active %} is-active{% endif %}">
                {{ link.title | escape }}
                {%- if megamenu_block.settings.badge_text != blank -%}
                  <span class="nectar-menu-badge" style="background-color: {{ megamenu_block.settings.badge_bg_color }}; color: {{ megamenu_block.settings.badge_text_color }};">
                    {{ megamenu_block.settings.badge_text }}
                  </span>
                {%- endif -%}
                {%- if megamenu_block != nil or link.links != blank -%}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left: 2px;" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                {%- endif -%}
              </a>

              {%- if megamenu_block != nil -%}
                <div class="nectar-megamenu">
                  <div class="nectar-megamenu__inner">
                    <div class="nectar-megamenu__nav-cols">
                      {%- if link.links.size > 0 -%}
                        {%- for childlink in link.links -%}
                          <div class="nectar-megamenu__col">
                            <a href="{{ childlink.url }}" class="nectar-megamenu__heading-link">{{ childlink.title | escape }}</a>
                            {%- if childlink.links.size > 0 -%}
                              <ul class="nectar-megamenu__list" role="list">
                                {%- for grandchild in childlink.links -%}
                                  <li><a href="{{ grandchild.url }}" class="nectar-megamenu__link">{{ grandchild.title | escape }}</a></li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      {%- else -%}
                        <div class="nectar-megamenu__col">
                          <span class="nectar-megamenu__heading-link">Immunity & Defense</span>
                          <ul class="nectar-megamenu__list" role="list">
                            <li><a href="/collections/all" class="nectar-megamenu__link">Vitamin C & Zinc</a></li>
                            <li><a href="/collections/all" class="nectar-megamenu__link">Natural Herbal Extracts</a></li>
                            <li><a href="/collections/all" class="nectar-megamenu__link">Cold & Flu Support</a></li>
                          </ul>
                        </div>
                        <div class="nectar-megamenu__col">
                          <span class="nectar-megamenu__heading-link">Daily Wellness</span>
                          <ul class="nectar-megamenu__list" role="list">
                            <li><a href="/collections/all" class="nectar-megamenu__link">Multivitamin Tablets</a></li>
                            <li><a href="/collections/all" class="nectar-megamenu__link">Omega-3 & Fish Oil</a></li>
                            <li><a href="/collections/all" class="nectar-megamenu__link">Gut & Digestive Health</a></li>
                          </ul>
                        </div>
                      {%- endif -%}
                    </div>
                    <div class="nectar-megamenu__side-media">
                      {%- if megamenu_block.settings.promo_heading_1 != blank or megamenu_block.settings.promo_image_1 != blank -%}
                        <div class="nectar-megamenu__promo-banner">
                          <a href="{{ megamenu_block.settings.promo_link_1 | default: '/collections/all' }}" class="nectar-megamenu__promo-inner">
                            {%- if megamenu_block.settings.promo_image_1 != blank -%}
                              <img src="{{ megamenu_block.settings.promo_image_1 | image_url: width: 500 }}" alt="{{ megamenu_block.settings.promo_heading_1 | escape }}" class="nectar-megamenu__promo-img" loading="lazy" />
                            {%- endif -%}
                            <div class="nectar-megamenu__promo-content">
                              <span class="nectar-megamenu__promo-tag">{{ megamenu_block.settings.promo_subheading_1 | default: 'Special Offer' }}</span>
                              <h4 class="nectar-megamenu__promo-title">{{ megamenu_block.settings.promo_heading_1 | default: 'New Collection' }}</h4>
                              <span class="nectar-megamenu__promo-btn">{{ megamenu_block.settings.promo_button_text_1 | default: 'Explore Now' }} &rarr;</span>
                            </div>
                          </a>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- elsif link.links != blank -%}
                <ul class="nectar-subnav__dropdown" role="list">
                  {%- for childlink in link.links -%}
                    <li><a href="{{ childlink.url }}" class="nectar-subnav__dropdown-link">{{ childlink.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <!-- Complete Nectarflora Standard Menu -->
          <li class="nectar-subnav__item is-active">
            <a href="{{ routes.root_url }}" class="nectar-subnav__link is-active">Home</a>
          </li>
          <li class="nectar-subnav__item has-megamenu">
            <a href="/collections/all" class="nectar-subnav__link">
              Product by Benefits
              <span class="nectar-menu-badge" style="background-color: #EE5A24; color: #FFFFFF;">HOT</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left: 2px;">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
            <div class="nectar-megamenu">
              <div class="nectar-megamenu__inner">
                <div class="nectar-megamenu__nav-cols">
                  <div class="nectar-megamenu__col">
                    <span class="nectar-megamenu__heading-link">Immunity & Defense</span>
                    <ul class="nectar-megamenu__list" role="list">
                      <li><a href="/collections/all" class="nectar-megamenu__link">Vitamin C & Zinc</a></li>
                      <li><a href="/collections/all" class="nectar-megamenu__link">Natural Herbal Extracts</a></li>
                      <li><a href="/collections/all" class="nectar-megamenu__link">Cold & Flu Support</a></li>
                      <li><a href="/collections/all" class="nectar-megamenu__link">Antioxidant Blends</a></li>
                    </ul>
                  </div>
                  <div class="nectar-megamenu__col">
                    <span class="nectar-megamenu__heading-link">Daily Wellness</span>
                    <ul class="nectar-megamenu__list" role="list">
                      <li><a href="/collections/all" class="nectar-megamenu__link">Multivitamin Tablets</a></li>
                      <li><a href="/collections/all" class="nectar-megamenu__link">Omega-3 & Fish Oil</a></li>
                      <li><a href="/collections/all" class="nectar-megamenu__link">Energy & Stamina</a></li>
                      <li><a href="/collections/all" class="nectar-megamenu__link">Gut Health & Probiotics</a></li>
                    </ul>
                  </div>
                  <div class="nectar-megamenu__col">
                    <span class="nectar-megamenu__heading-link">Skin & Hair Care</span>
                    <ul class="nectar-megamenu__list" role="list">
                      <li><a href="/collections/all" class="nectar-megamenu__link">Collagen Peptides</a></li>
                      <li><a href="/collections/all" class="nectar-megamenu__link">Biotin Hair Gummies</a></li>
                      <li><a href="/collections/all" class="nectar-megamenu__link">Glow & Hydration Serums</a></li>
                      <li><a href="/collections/all" class="nectar-megamenu__link">Anti-Aging Nutrition</a></li>
                    </ul>
                  </div>
                </div>
                <div class="nectar-megamenu__side-media">
                  <div class="nectar-megamenu__promo-banner">
                    <a href="/collections/all" class="nectar-megamenu__promo-inner">
                      <div class="nectar-megamenu__promo-content">
                        <span class="nectar-megamenu__promo-tag">Special Offer</span>
                        <h4 class="nectar-megamenu__promo-title">100% Organic Nutrition</h4>
                        <span class="nectar-megamenu__promo-btn">Explore Now &rarr;</span>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </li>
          <li class="nectar-subnav__item has-megamenu">
            <a href="/collections" class="nectar-subnav__link">
              Product by Category
              <span class="nectar-menu-badge" style="background-color: #0A8754; color: #FFFFFF;">NEW</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left: 2px;">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
            <div class="nectar-megamenu">
              <div class="nectar-megamenu__inner">
                <div class="nectar-megamenu__nav-cols">
                  <div class="nectar-megamenu__col">
                    <span class="nectar-megamenu__heading-link">Nutrition & Herbs</span>
                    <ul class="nectar-megamenu__list" role="list">
                      <li><a href="/collections" class="nectar-megamenu__link">Superfood Powders</a></li>
                      <li><a href="/collections" class="nectar-megamenu__link">Plant Protein</a></li>
                      <li><a href="/collections" class="nectar-megamenu__link">Ayurvedic Juices</a></li>
                    </ul>
                  </div>
                  <div class="nectar-megamenu__col">
                    <span class="nectar-megamenu__heading-link">Organic Beauty</span>
                    <ul class="nectar-megamenu__list" role="list">
                      <li><a href="/collections" class="nectar-megamenu__link">Natural Face Oils</a></li>
                      <li><a href="/collections" class="nectar-megamenu__link">Herbal Shampoos</a></li>
                      <li><a href="/collections" class="nectar-megamenu__link">Body Cleansers</a></li>
                    </ul>
                  </div>
                </div>
                <div class="nectar-megamenu__side-media">
                  <div class="nectar-megamenu__promo-banner">
                    <a href="/collections" class="nectar-megamenu__promo-inner promo--alt">
                      <div class="nectar-megamenu__promo-content">
                        <span class="nectar-megamenu__promo-tag">Trending</span>
                        <h4 class="nectar-megamenu__promo-title">Best Sellers Collection</h4>
                        <span class="nectar-megamenu__promo-btn">Shop Now &rarr;</span>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </li>
          <li class="nectar-subnav__item">
            <a href="/pages/free-consultation" class="nectar-subnav__link">Free Consultation</a>
          </li>
          <li class="nectar-subnav__item">
            <a href="/pages/about-us" class="nectar-subnav__link">About Us</a>
          </li>
          <li class="nectar-subnav__item">
            <a href="/blogs/news" class="nectar-subnav__link">Blogs</a>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </nav>
</div>

<!-- Sliding Side Drawer (Exact Image 1 Design: Deep Green Header, Logo Pill, Chevrons, Help Card) -->
<div class="nectar-drawer-backdrop" aria-hidden="true"></div>
<aside class="nectar-drawer" aria-label="Mobile Navigation" role="dialog" aria-modal="true">
  <!-- Deep Forest Green Header with White Logo Pill -->
  <div class="nectar-drawer__header">
    <div class="nectar-drawer__logo-badge">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {{
          settings.logo
          | image_url: width: 350
          | image_tag:
            class: 'nectar-header__logo-img',
            style: 'max-height: 32px; max-width: 150px; width: auto; object-fit: contain;',
            alt: logo_alt,
            preload: true
        }}
      {%- else -%}
        <span class="nectar-header__logo-text">
          <span class="logo-orange">Nectar</span><span class="logo-green">flora</span><sup class="logo-tm">™</sup>
        </span>
      {%- endif -%}
    </div>
    <button type="button" class="nectar-drawer__close-btn" aria-label="Close menu" title="Close menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="nectar-drawer__content">
    <ul class="nectar-drawer__menu" role="list">
      <!-- Item 1: Home -->
      <li class="nectar-drawer__item">
        <a href="{{ routes.root_url }}" class="nectar-drawer__link-row">
          <span class="nectar-drawer__link-text">Home</span>
          <span class="nectar-drawer__chevron">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        </a>
      </li>

      <!-- Item 2: Product by Benefits (Accordion) -->
      <li class="nectar-drawer__item has-accordion">
        <div class="nectar-drawer__link-row">
          <span class="nectar-drawer__link-text">Product by Benefits</span>
          <span class="nectar-drawer__chevron">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        </div>
        <div class="nectar-drawer__subcontent">
