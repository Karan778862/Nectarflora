{{ 'nectar-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #NectarFooter-{{ section.id }} {
    --footer-bg: {{ section.settings.bg_color | default: '#0B3526' }};
    --footer-text: {{ section.settings.text_color | default: '#C2D6CC' }};
    --footer-pt: {{ section.settings.padding_top }}px;
    --footer-pb: {{ section.settings.padding_bottom }}px;
    --footer-pt-mob: {{ section.settings.padding_top | times: 0.65 | round: 0 }}px;
    --footer-pb-mob: {{ section.settings.padding_bottom | times: 0.65 | round: 0 }}px;
  }
{%- endstyle -%}

<footer class="nectar-footer" id="NectarFooter-{{ section.id }}" role="contentinfo">
  <div class="nectar-footer-container">
    
    <div class="nectar-footer-grid">
      
      <!-- ================= COLUMN 1: BRAND INFO & CONTACT ================= -->
      <div class="nectar-footer-col nectar-footer-col--brand">
        <!-- Logo Badge -->
        <a href="{{ routes.root_url }}" class="nectar-footer-logo-badge" aria-label="{{ shop.name }}">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: section.settings.logo_width | times: 2 }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              class="nectar-footer-logo-img"
              width="{{ section.settings.logo_width }}"
              height="auto"
              loading="lazy"
            >
          {%- elsif settings.logo != blank -%}
            <img
              src="{{ settings.logo | image_url: width: 280 }}"
              alt="{{ settings.logo.alt | default: shop.name | escape }}"
              class="nectar-footer-logo-img"
              width="140"
              height="auto"
              loading="lazy"
            >
          {%- else -%}
            <span class="nectar-footer-logo-text">
              <span class="logo-nectar">Nectar</span><span class="logo-flora">flora</span><span class="logo-tm">™</span>
            </span>
          {%- endif -%}
        </a>

        <!-- Company Description -->
        {%- if section.settings.company_description != blank -%}
          <div class="nectar-footer-company-desc">
            {{ section.settings.company_description | escape }}
          </div>
        {%- endif -%}

        <!-- Contact List -->
        <div class="nectar-footer-contact-list">
          {%- if section.settings.address != blank -%}
            <div class="nectar-footer-contact-item">
              <span class="nectar-footer-contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </span>
              <span>Address: {{ section.settings.address | escape }}</span>
            </div>
          {%- endif -%}

          {%- if section.settings.fssai_no != blank -%}
            <div class="nectar-footer-contact-item">
              <span class="nectar-footer-contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <polyline points="9 12 11 14 15 10"></polyline>
                </svg>
              </span>
              <span>FSSAI License No.: {{ section.settings.fssai_no | escape }}</span>
            </div>
          {%- endif -%}

          {%- if section.settings.phone != blank -%}
            <div class="nectar-footer-contact-item">
              <span class="nectar-footer-contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </span>
              <a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone | escape }}</a>
            </div>
          {%- endif -%}

          {%- if section.settings.email != blank -%}
            <div class="nectar-footer-contact-item">
              <span class="nectar-footer-contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </span>
              <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- ================= COLUMN 2: SHOP BY CONCERN ================= -->
      <div class="nectar-footer-col nectar-footer-col--menu">
        <h3 class="nectar-footer-heading">{{ section.settings.heading_concern | default: 'Shop by Concern' }}</h3>
        <ul class="nectar-footer-links">
          {%- if section.settings.menu_concern != blank and section.settings.menu_concern.links.size > 0 -%}
            {%- for link in section.settings.menu_concern.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/collections/all">Fitness</a></li>
            <li><a href="/collections/all">Weight Loss</a></li>
            <li><a href="/collections/all">Hair Health</a></li>
            <li><a href="/collections/all">Skin Health</a></li>
            <li><a href="/collections/all">Sleep & Stress</a></li>
            <li><a href="/collections/all">Liver & Digestion</a></li>
            <li><a href="/collections/all">Women Health</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- ================= COLUMN 3: SHOP BY CATEGORY ================= -->
      <div class="nectar-footer-col nectar-footer-col--menu">
        <h3 class="nectar-footer-heading">{{ section.settings.heading_category | default: 'Shop by Category' }}</h3>
        <ul class="nectar-footer-links">
          {%- if section.settings.menu_category != blank and section.settings.menu_category.links.size > 0 -%}
            {%- for link in section.settings.menu_category.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/collections/all">Protein</a></li>
            <li><a href="/collections/all">Multivitamins</a></li>
            <li><a href="/collections/all">Biotin</a></li>
            <li><a href="/collections/all">Collagen</a></li>
            <li><a href="/collections/all">Hair Care</a></li>
            <li><a href="/collections/all">Skin Care</a></li>
            <li><a href="/collections/all">Superfood</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- ================= COLUMN 4: QUICK LINKS ================= -->
      <div class="nectar-footer-col nectar-footer-col--menu">
        <h3 class="nectar-footer-heading">{{ section.settings.heading_quick_links | default: 'Quick Links' }}</h3>
        <ul class="nectar-footer-links">
          {%- if section.settings.menu_quick_links != blank and section.settings.menu_quick_links.links.size > 0 -%}
            {%- for link in section.settings.menu_quick_links.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/about-us">About Us</a></li>
            <li><a href="/pages/track-order">Track Order</a></li>
            <li><a href="/pages/shipping-delivery">Shipping & Delivery</a></li>
            <li><a href="/pages/cancellations-refunds">Cancellations & Refunds</a></li>
            <li><a href="/policies/terms-of-service">Terms</a></li>
            <li><a href="/policies/privacy-policy">Privacy</a></li>
            <li><a href="/blogs/news">Blogs</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- ================= COLUMN 5: TRUST, SOCIALS & CERTS ================= -->
      <div class="nectar-footer-col nectar-footer-col--trust">
        
        <!-- Pay Securely Using -->
        {%- if section.settings.show_payments -%}
          <div class="nectar-footer-subgroup">
            <h4 class="nectar-footer-subheading">{{ section.settings.heading_payments | default: 'Pay securely using' }}</h4>
            <div class="nectar-footer-payments">
              <span class="nectar-payment-pill">VISA</span>
              <span class="nectar-payment-pill">MasterCard</span>
              <span class="nectar-payment-pill">RuPay</span>
              <span class="nectar-payment-pill">UPI</span>
              <span class="nectar-payment-pill">GPay</span>
              <span class="nectar-payment-pill">PhonePe</span>
              <span class="nectar-payment-pill">Paytm</span>
            </div>
          </div>
        {%- endif -%}

        <!-- Show Us Some Love On (Socials) -->
        {%- if section.settings.show_socials -%}
          <div class="nectar-footer-subgroup">
            <h4 class="nectar-footer-subheading">{{ section.settings.heading_socials | default: 'Show us some love on' }}</h4>
            <div class="nectar-footer-socials">
              <a href="{{ section.settings.social_facebook | default: settings.social_facebook_link | default: '#' }}" class="nectar-social-btn" aria-label="Facebook" target="_blank" rel="noopener">f</a>
              <a href="{{ section.settings.social_instagram | default: settings.social_instagram_link | default: '#' }}" class="nectar-social-btn" aria-label="Instagram" target="_blank" rel="noopener">ig</a>
              <a href="{{ section.settings.social_x | default: settings.social_twitter_link | default: '#' }}" class="nectar-social-btn" aria-label="X (Twitter)" target="_blank" rel="noopener">x</a>
              <a href="{{ section.settings.social_youtube | default: settings.social_youtube_link | default: '#' }}" class="nectar-social-btn" aria-label="YouTube" target="_blank" rel="noopener">yt</a>
            </div>
          </div>
        {%- endif -%}

        <!-- Affiliated Certificates -->
        {%- if section.settings.show_certificates -%}
          <div class="nectar-footer-subgroup">
            <h4 class="nectar-footer-subheading">{{ section.settings.heading_certificates | default: 'Affiliated Certificates' }}</h4>
            <div class="nectar-footer-certificates">
              <span class="nectar-cert-badge">{{ section.settings.cert_1 | default: 'FSSAI' }}</span>
              <span class="nectar-cert-badge">{{ section.settings.cert_2 | default: 'GMP' }}</span>
              <span class="nectar-cert-badge">{{ section.settings.cert_3 | default: 'HACCP' }}</span>
            </div>
          </div>
        {%- endif -%}

      </div>

    </div>

    <!-- ================= BOTTOM BAR ================= -->
    <div class="nectar-footer-bottom">
      <p class="nectar-footer-copyright">
        {{ section.settings.copyright_text | default: '© 2026 [Brand Name]. All rights reserved.' }}
      </p>
      <p class="nectar-footer-disclaimer">
        {{ section.settings.disclaimer_text | default: 'Products are not intended to diagnose, treat, cure or prevent any disease.' }}
      </p>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Nectarflora Footer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "default": "#0B3526",
      "label": "Footer Background Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#C2D6CC",
      "label": "Text Color"
    },
    {
      "type": "header",
      "content": "Brand Info & Contact"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Footer Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 240,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "text",
      "id": "company_description",
      "default": "[Brand Name] is a brand owned by [Company Name] Pvt. Ltd.",
      "label": "Company Description"
    },
    {
      "type": "text",
      "id": "address",
      "default": "Plot No. 00, Industrial Area, City, State - 000000",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "fssai_no",
      "default": "00000000000000",
      "label": "FSSAI License No."
    },
    {
      "type": "text",
      "id": "phone",
      "default": "+91 00000 00000",
      "label": "Phone Number"
    },
    {
      "type": "text",
      "id": "email",
      "default": "care@yourbrand.com",
      "label": "Email Address"
    },
    {
      "type": "header",
      "content": "Navigation Columns"
    },
    {
      "type": "text",
      "id": "heading_concern",
      "default": "Shop by Concern",
      "label": "Column 2 Heading"
    },
    {
      "type": "link_list",
      "id": "menu_concern",
      "label": "Column 2 Menu"
    },
    {
      "type": "text",
      "id": "heading_category",
      "default": "Shop by Category",
      "label": "Column 3 Heading"
    },
    {
      "type": "link_list",
      "id": "menu_category",
      "label": "Column 3 Menu"
    },
    {
      "type": "text",
      "id": "heading_quick_links",
      "default": "Quick Links",
      "label": "Column 4 Heading"
    },
    {
      "type": "link_list",
      "id": "menu_quick_links",
      "label": "Column 4 Menu"
    },
    {
      "type": "header",
      "content": "Payments, Socials & Certifications"
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "default": true,
      "label": "Show Payment Badges"
    },
    {
      "type": "text",
      "id": "heading_payments",
      "default": "Pay securely using",
      "label": "Payment Heading"
    },
    {
      "type": "checkbox",
      "id": "show_socials",
      "default": true,
      "label": "Show Social Media Buttons"
    },
    {
      "type": "text",
      "id": "heading_socials",
      "default": "Show us some love on",
      "label": "Socials Heading"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "X (Twitter) URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "checkbox",
      "id": "show_certificates",
      "default": true,
      "label": "Show Affiliated Certificates"
    },
    {
      "type": "text",
      "id": "heading_certificates",
      "default": "Affiliated Certificates",
      "label": "Certificates Heading"
    },
    {
      "type": "text",
      "id": "cert_1",
      "default": "FSSAI",
      "label": "Certificate 1 Text"
    },
    {
      "type": "text",
      "id": "cert_2",
      "default": "GMP",
      "label": "Certificate 2 Text"
    },
    {
      "type": "text",
      "id": "cert_3",
      "default": "HACCP",
      "label": "Certificate 3 Text"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "default": "© 2026 [Brand Name]. All rights reserved.",
      "label": "Copyright Text"
    },
    {
      "type": "text",
      "id": "disclaimer_text",
      "default": "Products are not intended to diagnose, treat, cure or prevent any disease.",
      "label": "Medical Disclaimer Text"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Nectarflora Footer"
    }
  ]
}
{% endschema %}
