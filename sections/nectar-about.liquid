 {"type":"principles","name":"Three brand principles","settings":[{"type":"text","id":"label","label":"Eyebrow","default":"What matters to us"},{"type":"text","id":"heading","label":"Heading","default":"A considered approach to wellbeing."},{"type":"text","id":"title_1","label":"First title","default":"Clarity"},{"type":"textarea","id":"text_1","label":"First text","default":"We believe product information should help you understand your choices."},{"type":"text","id":"title_2","label":"Second title","default":"Individuality"},{"type":"textarea","id":"text_2","label":"Second text","default":"Your routine should reflect your needs, preferences and goals."},{"type":"text","id":"title_3","label":"Third title","default":"Consistency"},{"type":"textarea","id":"text_3","label":"Third text","default":"Everyday habits are at the heart of our idea of wellness."}]},
