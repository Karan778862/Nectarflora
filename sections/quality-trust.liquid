{{ 'section-quality-trust.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #QualityTrust-{{ section.id }} {
    --trust-bg: {{ section.settings.bg_color }};
    --trust-heading-color: {{ section.settings.heading_color }};
    --trust-subheading-color: {{ section.settings.subheading_color }};
    --trust-circle-bg: {{ section.settings.circle_bg }};
    --trust-circle-border: {{ section.settings.circle_border }};
    --trust-icon-color: {{ section.settings.icon_color }};
    --trust-pt: {{ section.settings.padding_top }}px;
    --trust-pb: {{ section.settings.padding_bottom }}px;
    --trust-pt-mob: {{ section.settings.padding_top | times: 0.65 | round: 0 }}px;
    --trust-pb-mob: {{ section.settings.padding_bottom | times: 0.65 | round: 0 }}px;
  }
{%- endstyle -%}

<section class="nectar-trust-section" id="QualityTrust-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">
  <div class="nectar-trust-container">
    
    <!-- Section Header -->
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="nectar-trust-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="nectar-trust-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="nectar-trust-subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Trust Badges Grid -->
    <div class="nectar-trust-grid {% if section.settings.layout_mobile == 'grid_3' %}nectar-trust-grid--3-mob{% elsif section.settings.layout_mobile == 'swipe' %}nectar-trust-grid--swipe-mob{% endif %}">
      {%- for block in section.blocks -%}
        <div class="nectar-trust-item" {{ block.shopify_attributes }}>
          
          <div class="nectar-trust-circle">
            <span class="nectar-trust-icon">
              {%- if block.settings.custom_image != blank -%}
                <img
                  src="{{ block.settings.custom_image | image_url: width: 80 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  class="nectar-trust-img"
                  width="38"
                  height="38"
                >
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'factory' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 21h18"/>
                      <path d="M5 21V11l5 4V9l6 4V6h4v15"/>
                      <path d="M19 10h.01"/>
                      <path d="M19 14h.01"/>
                    </svg>

                  {%- when 'clipboard' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                      <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
                      <polyline points="9 13 11 15 15 11"/>
                    </svg>

                  {%- when 'gluten_free' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="2" y1="2" x2="22" y2="22" />
                      <path d="M7 10c0-1.5.8-2.8 2-3.4" />
                      <path d="M11.3 5.6C12 4.6 13.3 4 14.8 4c0 3-1.8 5.4-4 6" />
                      <path d="M17.5 15c0 1.5-.8 2.8-2 3.4" />
                      <path d="M12.7 18.4c-.7 1-2 1.6-3.5 1.6 0-3 1.8-5.4 4-6" />
                      <path d="M12 22V12" />
                      <path d="M12 7V2" />
                    </svg>

                  {%- when 'certified_badge' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2l2.4 2.4 3.4-.4 1 3.2 3.1 1.5-.8 3.3 2.1 2.7-2.1 2.7.8 3.3-3.1 1.5-1 3.2-3.4-.4L12 22l-2.4-2.4-3.4.4-1-3.2-3.1-1.5.8-3.3-2.1-2.7 2.1-2.7-.8-3.3 3.1-1.5 1-3.2 3.4.4L12 2z"/>
                      <polyline points="9 12 11 14 15 10"/>
                    </svg>

                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 10a4 4 0 0 1 4-4h4v4a4 4 0 0 1-4 4"/>
                      <path d="M12 14a4 4 0 0 0-4-4H4v4a4 4 0 0 0 4 4"/>
                      <path d="M12 6v15"/>
                      <path d="M8 21h8"/>
                    </svg>

                  {%- when 'microscope' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 18h8"/>
                      <path d="M3 22h18"/>
                      <path d="M14 22a7 7 0 1 0 0-14h-1"/>
                      <path d="M9 14h2"/>
                      <path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/>
                      <path d="M12 6V3a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v3"/>
                    </svg>

                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      <polyline points="9 12 11 14 15 10"/>
                    </svg>

                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>

                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 6 12 12 16 14"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
          </div>

          <div class="nectar-trust-content">
            {%- if block.settings.title != blank -%}
              <h3 class="nectar-trust-item-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="nectar-trust-item-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Quality Trust Badges",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Quality You Can Trust",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "default": "Our whole-food ingredients and full-spectrum herbal blends are made in certified facilities",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "bg_color",
      "default": "#EAF5EE",
      "label": "Section Background"
    },
    {
      "type": "color",
      "id": "heading_color",
      "default": "#0D3B2B",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "default": "#4A6B5D",
      "label": "Subheading Color"
    },
    {
      "type": "color",
      "id": "circle_bg",
      "default": "#FFFFFF",
      "label": "Circle Background"
    },
    {
      "type": "color",
      "id": "circle_border",
      "default": "#A3D9B8",
      "label": "Circle Border Color"
    },
    {
      "type": "color",
      "id": "icon_color",
      "default": "#0A8754",
      "label": "Icon Color"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "options": [
        {
          "value": "grid_2",
          "label": "2 Columns Grid"
        },
        {
          "value": "grid_3",
          "label": "3 Columns Grid"
        },
        {
          "value": "swipe",
          "label": "Horizontal Swipe"
        }
      ],
      "default": "grid_2",
      "label": "Mobile Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "factory",
              "label": "Factory (GMP)"
            },
            {
              "value": "clipboard",
              "label": "Clipboard Check (HACCP)"
            },
            {
              "value": "gluten_free",
              "label": "Gluten Free (Wheat Off)"
            },
            {
              "value": "certified_badge",
              "label": "Rosette Seal (FSSAI)"
            },
            {
              "value": "leaf",
              "label": "Seedling Plant (Non-GMO)"
            },
            {
              "value": "microscope",
              "label": "Microscope (Lab Tested)"
            },
            {
              "value": "shield",
              "label": "Shield Check"
            },
            {
              "value": "heart",
              "label": "Heart"
            }
          ],
          "default": "factory"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Optional Custom Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "GMP Certified"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subtitle",
          "default": "WHO-GMP certified facility"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quality Trust Badges",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "icon": "factory",
            "title": "GMP Certified",
            "text": "WHO-GMP certified facility"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "clipboard",
            "title": "HACCP",
            "text": "Food safety management"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "gluten_free",
            "title": "Gluten Free",
            "text": "No gluten, no fillers"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "certified_badge",
            "title": "FSSAI Certified",
            "text": "Licensed by FSSAI, India"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "leaf",
            "title": "Non-GMO",
            "text": "Clean, natural sourcing"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "microscope",
            "title": "Lab Tested",
            "text": "Third-party tested batches"
          }
        }
      ]
    }
  ]
}
{% endschema %}
