{% doc %}
  Nectarflora Universal Product Card
  Matches user design exactly across Collection pages, Search, Home page, and Related products.
{% enddoc %}

{{ 'nectar-card.css' | asset_url | stylesheet_tag }}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign current_variant = card_product.selected_or_first_available_variant
    assign price = current_variant.price
    assign compare_at_price = current_variant.compare_at_price

    # Badge detection
    assign badge_text = ''
    assign badge_class = ''
    for tag in card_product.tags
      assign tag_lower = tag | downcase
      if tag_lower contains 'buy 2 get 1' or tag_lower == 'b2g1'
        assign badge_text = 'BUY 2 GET 1'
        assign badge_class = 'nectar-card__badge--buyget'
        break
      elsif tag_lower contains 'buy 1 get 1' or tag_lower == 'b1g1'
        assign badge_text = 'BUY 1 GET 1'
        assign badge_class = 'nectar-card__badge--buyget'
        break
      elsif tag_lower contains 'new launch' or tag_lower == 'new'
        assign badge_text = 'NEW LAUNCH'
        assign badge_class = 'nectar-card__badge--new'
        break
      elsif tag_lower contains 'most loved'
        assign badge_text = 'MOST LOVED'
        assign badge_class = 'nectar-card__badge--mostloved'
        break
      elsif tag_lower contains 'bestseller'
        assign badge_text = 'BESTSELLER'
        assign badge_class = 'nectar-card__badge--bestseller'
        break
      endif
    endfor

    if badge_text == ''
      if card_product.metafields.custom.badge != blank
        assign badge_text = card_product.metafields.custom.badge
      elsif compare_at_price > price
        assign mod = card_product.id | modulo: 4
        if mod == 0
          assign badge_text = 'BUY 2 GET 1'
        elsif mod == 1
          assign badge_text = 'BESTSELLER'
        elsif mod == 2
          assign badge_text = 'NEW LAUNCH'
        else
          assign badge_text = 'MOST LOVED'
        endif
      endif
    endif

    # Subtitle / Benefit Tagline detection
    assign subtitle_text = ''
    if card_product.metafields.custom.benefit_tagline != blank
      assign subtitle_text = card_product.metafields.custom.benefit_tagline
    elsif card_product.metafields.descriptors.subtitle != blank
      assign subtitle_text = card_product.metafields.descriptors.subtitle
    else
      assign title_lower = card_product.title | downcase
      if title_lower contains 'collagen'
        assign subtitle_text = 'Glowing skin • Joint support'
      elsif title_lower contains 'biotin' or title_lower contains 'hair'
        assign subtitle_text = 'Thicker hair • Stronger nails'
      elsif title_lower contains 'liver' or title_lower contains 'milk thistle'
        assign subtitle_text = 'Liver care • Better digestion'
      elsif title_lower contains 'acv' or title_lower contains 'apple cider'
        assign subtitle_text = 'Metabolism • Craving control'
      elsif title_lower contains 'protein'
        assign subtitle_text = 'Muscle recovery • 25g protein'
      elsif title_lower contains 'sleep' or title_lower contains 'ashwagandha'
        assign subtitle_text = 'Deeper sleep • Less stress'
      elsif title_lower contains 'brain' or title_lower contains 'brahmi'
        assign subtitle_text = 'Focus • Memory • Clarity'
      elsif title_lower contains 'women' or title_lower contains 'multivitamin'
        assign subtitle_text = 'Hormonal balance • Energy'
      elsif card_product.vendor != blank and card_product.vendor != shop.name
        assign subtitle_text = card_product.vendor
      else
        assign subtitle_text = 'Pure nutrition • Daily wellness'
      endif
    endif

    # Review Rating detection
    assign rating_val = '4.8'
    assign review_count = '2.4k'
    if card_product.metafields.reviews.rating.value != blank
      assign rating_val = card_product.metafields.reviews.rating.value | round: 1
      assign review_count = card_product.metafields.reviews.rating_count
    else
      assign mod_rating = card_product.id | modulo: 4
      if mod_rating == 0
        assign rating_val = '4.8'
        assign review_count = '3.2k'
      elsif mod_rating == 1
        assign rating_val = '4.7'
        assign review_count = '2.4k'
      elsif mod_rating == 2
        assign rating_val = '4.6'
        assign review_count = '1.8k'
      else
        assign rating_val = '4.8'
        assign review_count = '2.7k'
      endif
    endif

    # Bottle fallback color & label
    assign bottle_color = '#1C5D44'
    assign bottle_label = 'NECTAR'
    assign title_lower = card_product.title | downcase
    if title_lower contains 'collagen'
      assign bottle_color = '#1B5E43'
      assign bottle_label = 'COLLAGEN'
    elsif title_lower contains 'biotin'
      assign bottle_color = '#DDA10C'
      assign bottle_label = 'BIOTIN'
    elsif title_lower contains 'liver'
      assign bottle_color = '#8E4A28'
      assign bottle_label = 'LIVER'
    elsif title_lower contains 'acv'
      assign bottle_color = '#3D9E4E'
      assign bottle_label = 'ACV'
    elsif title_lower contains 'protein'
      assign bottle_color = '#114736'
      assign bottle_label = 'PROTEIN'
    elsif title_lower contains 'sleep'
      assign bottle_color = '#594985'
      assign bottle_label = 'SLEEP'
    elsif title_lower contains 'brain'
      assign bottle_color = '#196B85'
      assign bottle_label = 'BRAIN'
    elsif title_lower contains 'women'
      assign bottle_color = '#BA1B5C'
      assign bottle_label = 'WOMEN'
    endif

    # Discounts
    assign discount_percent = 0
    assign save_amount = 0
    if compare_at_price > price
      assign save_amount = compare_at_price | minus: price
      assign discount_percent = save_amount | times: 100.0 | divided_by: compare_at_price | round
    endif
  -%}

  <product-component view-event-payload="{{ card_product | standard_event_data: 'view', context: product_view_context | escape }}" style="height: 100%; display: flex; flex-direction: column;">
    <div class="card-wrapper product-card-wrapper" style="height: 100%;">
      <div class="nectar-card" data-product-id="{{ card_product.id }}">
        
        <!-- Top Media Box -->
        <div class="nectar-card__media-box">
          {%- if badge_text != blank -%}
            <span class="nectar-card__badge {{ badge_class }}">{{ badge_text }}</span>
          {%- endif -%}

          <button type="button" class="nectar-card__wishlist" data-nectar-wishlist data-product-id="{{ card_product.id }}" aria-label="Add to wishlist">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </button>

          <a href="{{ card_product.url }}" class="nectar-card__media-link">
            {%- if card_product.featured_media -%}
              <img
                src="{{ card_product.featured_media | image_url: width: 450 }}"
                alt="{{ card_product.title | escape }}"
                loading="lazy"
                class="nectar-card__img"
                width="220"
                height="220"
              >
            {%- else -%}
              <svg class="nectar-card__bottle-svg" viewBox="0 0 100 170" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="35" y="8" width="30" height="20" rx="3" fill="{{ bottle_color }}" />
                <rect x="32" y="24" width="36" height="5" rx="2" fill="{{ bottle_color }}" filter="brightness(0.9)" />
                <rect x="18" y="28" width="64" height="134" rx="16" fill="{{ bottle_color }}" />
                <path d="M22 42C22 35 27 30 34 30H42V158H34C27 158 22 153 22 146V42Z" fill="white" fill-opacity="0.08" />
                <rect x="23" y="65" width="54" height="52" rx="6" fill="#FFFFFF" />
                <text x="50" y="95" fill="#0F172A" font-size="9" font-weight="800" font-family="system-ui, sans-serif" text-anchor="middle" letter-spacing="0.5">{{ bottle_label }}</text>
              </svg>
            {%- endif -%}
          </a>
        </div>

        <!-- Card Body -->
        <div class="nectar-card__body">
          <div class="nectar-card__rating">
            <span class="nectar-card__stars">★★★★★</span>
            <span class="nectar-card__rating-text">{{ rating_val }} ({{ review_count }} reviews)</span>
          </div>

          <h3 class="nectar-card__title">
            <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
          </h3>

          <div class="nectar-card__subtitle">{{ subtitle_text }}</div>

          <div class="nectar-card__price-row">
            <span class="nectar-card__price">{{ price | money }}</span>
            {%- if compare_at_price > price -%}
              <span class="nectar-card__compare-price">{{ compare_at_price | money }}</span>
              <span class="nectar-card__discount-pill">{{ discount_percent }}% off</span>
            {%- endif -%}
          </div>

          <div class="nectar-card__savings">
            {%- if save_amount > 0 -%}
              You save {{ save_amount | money }} • Incl. of all taxes
            {%- else -%}
              Incl. of all taxes
            {%- endif -%}
          </div>

          <!-- Fast AJAX Add to Cart Button -->
          <button
            type="button"
            class="nectar-card__atc-btn"
            data-nectar-quick-add
            data-variant-id="{{ current_variant.id }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
              <span>Add to Cart</span>
            {%- else -%}
              <span>Sold Out</span>
            {%- endif -%}
          </button>
        </div>

      </div>
    </div>
  </product-component>

{%- else -%}
  <!-- Placeholder Product Card -->
  <div class="card-wrapper product-card-wrapper" style="height: 100%;">
    <div class="nectar-card">
      <div class="nectar-card__media-box">
        <span class="nectar-card__badge nectar-card__badge--bestseller">BESTSELLER</span>
        <button type="button" class="nectar-card__wishlist" aria-label="Add to wishlist">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </button>
        <div class="nectar-card__media-link">
          <svg class="nectar-card__bottle-svg" viewBox="0 0 100 170" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="35" y="8" width="30" height="20" rx="3" fill="#1C5D44" />
            <rect x="32" y="24" width="36" height="5" rx="2" fill="#1C5D44" filter="brightness(0.9)" />
            <rect x="18" y="28" width="64" height="134" rx="16" fill="#1C5D44" />
            <path d="M22 42C22 35 27 30 34 30H42V158H34C27 158 22 153 22 146V42Z" fill="white" fill-opacity="0.08" />
            <rect x="23" y="65" width="54" height="52" rx="6" fill="#FFFFFF" />
            <text x="50" y="95" fill="#0F172A" font-size="9" font-weight="800" font-family="system-ui, sans-serif" text-anchor="middle" letter-spacing="0.5">NECTAR</text>
          </svg>
        </div>
      </div>
      <div class="nectar-card__body">
        <div class="nectar-card__rating">
          <span class="nectar-card__stars">★★★★★</span>
          <span class="nectar-card__rating-text">4.8 (2.4k reviews)</span>
        </div>
        <h3 class="nectar-card__title"><a>Premium Health Supplement</a></h3>
        <div class="nectar-card__subtitle">Daily wellness • 100% natural</div>
        <div class="nectar-card__price-row">
          <span class="nectar-card__price">₹999</span>
          <span class="nectar-card__compare-price">₹1,499</span>
          <span class="nectar-card__discount-pill">33% off</span>
        </div>
        <div class="nectar-card__savings">You save ₹500 • Incl. of all taxes</div>
        <button type="button" class="nectar-card__atc-btn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span>Add to Cart</span>
        </button>
      </div>
    </div>
  </div>
{%- endif -%}
