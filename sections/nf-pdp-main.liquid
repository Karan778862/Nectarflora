{{ 'nf-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nf-pdp.js' | asset_url }}" defer></script>
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign form_id = 'NfProductForm-' | append: section.id %}
<product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
<nf-product class="nf-product nf-pdp-shell" data-section="{{ section.id }}" style="--nf-product-accent:{{ product.metafields.custom.color_hex.value | default: '#c7762e' }}">
  <div class="nf-product__gallery">
    <div class="nf-product__main-media">
      {% if current_variant.compare_at_price > current_variant.price %}<span class="nf-product__discount" data-nf-discount>{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}% {{ section.settings.off_label | escape }}</span>{% endif %}
      {% if product.media.size > 0 %}
        {% for media in product.media %}<div class="nf-product__slide" data-nf-media="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>{% if media.media_type == 'image' %}{{ media | image_url: width: 1400 | image_tag: widths: '360,540,750,1000,1400', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'eager', class: 'nf-product__image' }}{% else %}{{ media | media_tag: image_size: '1000x', controls: true, preload: 'none' }}{% endif %}</div>{% endfor %}
      {% else %}{{ 'product-1' | placeholder_svg_tag: 'nf-product__placeholder' }}{% endif %}
    </div>
    {% if product.media.size > 1 %}<div class="nf-product__thumbnails">{% for media in product.media %}<button type="button" data-nf-thumbnail="{{ media.id }}" aria-label="{{ section.settings.image_label | escape }} {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', sizes: '80px' }}</button>{% endfor %}</div>{% endif %}
  </div>
  <div class="nf-product__details">
    {% for block in section.blocks %}
      <div class="nf-product__block nf-product__block--{{ block.type }}" {{ block.shopify_attributes }}>
      {% case block.type %}
        {% when 'title' %}<h1>{{ product.title | escape }}</h1>{% assign subtitle = product.metafields.custom.pdp_subtitle.value | default: block.settings.subtitle %}{% if subtitle != blank %}<p class="nf-product__subtitle">{{ subtitle | escape }}</p>{% endif %}
        {% if product.metafields.reviews.rating.value != blank %}<p class="nf-product__rating"><span aria-hidden="true">★★★★★</span> {{ product.metafields.reviews.rating.value.rating }} / {{ product.metafields.reviews.rating.value.scale_max }} {% if product.metafields.reviews.rating_count != blank %}({{ product.metafields.reviews.rating_count }}){% endif %}</p>{% endif %}
        {% when 'tabs' %}
          {% assign tab_labels = block.settings.labels | split: '|' %}
          <div class="nf-product__tabs" role="tablist" aria-label="{{ block.settings.accessibility_label | escape }}">{% for label in tab_labels %}<button type="button" role="tab" id="NfTab-{{ section.id }}-{{ forloop.index }}" aria-controls="NfPanel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-nf-tab="{{ forloop.index }}">{{ label | escape }}</button>{% endfor %}</div>
          <div class="nf-product__panel rte" id="NfPanel-{{ section.id }}-1" role="tabpanel" aria-labelledby="NfTab-{{ section.id }}-1" data-nf-panel="1">{{ product.description | split: '<h3>' | first }}</div>
          <div class="nf-product__panel" id="NfPanel-{{ section.id }}-2" role="tabpanel" aria-labelledby="NfTab-{{ section.id }}-2" data-nf-panel="2" hidden>{% if product.metafields.custom.pdp_ingredients.value != blank %}<ul>{% for item in product.metafields.custom.pdp_ingredients.value %}<li><strong>{{ item.title.value | escape }}</strong> {{ item.text.value | escape }}</li>{% endfor %}</ul>{% else %}{{ product.metafields.custom.ingredients | metafield_tag }}{% endif %}</div>
          <div class="nf-product__panel" id="NfPanel-{{ section.id }}-3" role="tabpanel" aria-labelledby="NfTab-{{ section.id }}-3" data-nf-panel="3" hidden>{{ product.metafields.custom.how_to_take | metafield_tag }}</div>
          <div class="nf-product__panel" id="NfPanel-{{ section.id }}-4" role="tabpanel" aria-labelledby="NfTab-{{ section.id }}-4" data-nf-panel="4" hidden>{% for item in product.metafields.custom.pdp_faqs.value %}<details><summary>{{ item.title.value | escape }}</summary><p>{{ item.text.value | escape | newline_to_br }}</p></details>{% endfor %}</div>
          <div class="nf-product__panel" id="NfPanel-{{ section.id }}-5" role="tabpanel" aria-labelledby="NfTab-{{ section.id }}-5" data-nf-panel="5" hidden>{% if product.metafields.custom.pdp_lab_report.value != blank %}<a href="{{ product.metafields.custom.pdp_lab_report.value.url }}" target="_blank" rel="noopener">{{ block.settings.report_label | escape }}</a>{% else %}<p>{{ block.settings.report_empty | escape }}</p>{% endif %}</div>
          {% if product.metafields.custom.pdp_disclaimer != blank %}<p class="nf-product__disclaimer">{{ product.metafields.custom.pdp_disclaimer.value | escape }}</p>{% endif %}
          {% if block.settings.guidance_link != blank %}<a class="nf-product__guidance" href="{{ block.settings.guidance_link }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span>{{ block.settings.guidance_label | escape }}</span></a>{% endif %}
        {% when 'benefits' %}<div class="nf-product__benefits">{% for item in product.metafields.custom.pdp_benefits.value limit: 6 %}<div><span class="nf-product__benefit-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 6.2L21 12l-6.2 2.8L12 21l-2.8-6.2L3 12l6.2-2.8Z"/></svg></span><span>{{ item.title.value | escape }}</span></div>{% endfor %}</div>
        {% when 'price' %}<div class="nf-product__prices"><strong data-nf-price>{{ current_variant.price | money }}</strong><s data-nf-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s><span data-nf-saving></span></div><p class="nf-product__tax">{{ block.settings.tax_note | escape }}</p>
        {% when 'offers' %}{% if product.metafields.custom.pdp_offers.value != blank %}<div class="nf-product__offers"><h3>{{ block.settings.heading | escape }}</h3>{% for item in product.metafields.custom.pdp_offers.value %}<p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18v4H3zM5 12v9h14v-9M12 8v13M12 8H8a3 3 0 1 1 3-3l1 3Zm0 0h4a3 3 0 1 0-3-3l-1 3Z"/></svg><span class="nf-product__offer-code">{{ item.title.value | escape }}</span><span>{{ item.text.value | escape }}</span></p>{% endfor %}</div>{% elsif block.settings.code_1 != blank or block.settings.code_2 != blank or block.settings.code_3 != blank %}<div class="nf-product__offers"><h3>{{ block.settings.heading | escape }}</h3>{% for i in (1..3) %}{% assign code_key = 'code_' | append: i %}{% assign text_key = 'text_' | append: i %}{% if block.settings[code_key] != blank %}<p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18v4H3zM5 12v9h14v-9M12 8v13M12 8H8a3 3 0 1 1 3-3l1 3Zm0 0h4a3 3 0 1 0-3-3l-1 3Z"/></svg><span class="nf-product__offer-code">{{ block.settings[code_key] | escape }}</span><span>{{ block.settings[text_key] | escape }}</span></p>{% endif %}{% endfor %}</div>{% elsif request.design_mode %}<p class="nf-pdp-editor">Add valid offer codes and descriptions in this block to show Available Offers.</p>{% endif %}
        {% when 'purchase' %}
          {% form 'product', product, id: form_id, class: 'nf-product__form' %}
            {% unless product.has_only_default_variant %}<label class="nf-product__variant-label" for="NfVariant-{{ section.id }}">{{ block.settings.variant_label | escape }}</label>{% endunless %}
            <select name="id" id="NfVariant-{{ section.id }}" data-nf-variant {% if product.has_only_default_variant %}hidden{% endif %}>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} – {{ block.settings.sold_out_label | escape }}{% endunless %}</option>{% endfor %}</select>
            <h3>{{ block.settings.heading | escape }}</h3><div class="nf-product__bundles">{% for quantity in (1..3) %}<label class="nf-product__bundle"><input type="radio" name="quantity" value="{{ quantity }}" {% if forloop.first %}checked{% endif %}><span class="nf-product__bundle-art">{% for bottle in (1..quantity) %}<span>{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', sizes: '70px' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</span>{% endfor %}</span><span class="nf-product__bundle-badge">{% if quantity == 2 %}{{ block.settings.badge_2 | escape }}{% elsif quantity == 3 %}{{ block.settings.badge_3 | escape }}{% endif %}</span><span class="nf-product__bundle-choice"><strong>{{ block.settings.buy_label | escape }} {{ quantity }}</strong><span data-nf-bundle-price="{{ quantity }}">{{ current_variant.price | times: quantity | money }}</span></span></label>{% endfor %}</div>
            <button class="nf-product__add" type="submit" name="add" {% unless current_variant.available %}disabled{% endunless %} data-nf-add><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h3l3 13h10l3-10H7"/><circle cx="10" cy="21" r="1"/><circle cx="19" cy="21" r="1"/></svg><span>{% if current_variant.available %}{{ block.settings.add_label | escape }}{% else %}{{ block.settings.sold_out_label | escape }}{% endif %}</span></button>
            <button class="nf-product__buy" type="submit" name="checkout" {% unless current_variant.available %}disabled{% endunless %} data-nf-buy>{{ block.settings.checkout_label | escape }} <span aria-hidden="true">›</span></button>
            <p class="nf-product__error" role="status" aria-live="polite" data-nf-error></p>
          {% endform %}
          <script type="application/json" data-nf-variants>{{ product.variants | json }}</script>
          <script type="application/json" data-nf-config>{"moneyFormat":{{ shop.money_format | json }},"currency":{{ cart.currency.iso_code | default: shop.currency | json }},"add":{{ block.settings.add_label | json }},"soldOut":{{ block.settings.sold_out_label | json }},"adding":{{ block.settings.adding_label | json }},"added":{{ block.settings.added_label | json }},"error":{{ block.settings.error_label | json }}}</script>
        {% when 'trust' %}<div class="nf-product__trust">{% for i in (1..3) %}{% assign text_key = 'text_' | append: i %}{% if block.settings[text_key] != blank %}<span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>{{ block.settings[text_key] | escape }}</span>{% endif %}{% endfor %}</div>
        {% when 'report' %}{% if product.metafields.custom.pdp_lab_report.value != blank %}<div class="nf-product__lab"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8M10 3v6L4 19a1 1 0 0 0 1 2h14a1 1 0 0 0 1-2L14 9V3M8 14h8"/></svg><div><strong>{{ product.metafields.custom.pdp_report_text.value | default: block.settings.heading | escape }}</strong><p>{{ block.settings.text | escape }}</p></div><a href="{{ product.metafields.custom.pdp_lab_report.value.url }}" target="_blank" rel="noopener">{{ block.settings.link_label | escape }}</a></div>{% endif %}
      {% endcase %}
      </div>
    {% endfor %}
  </div>
</nf-product>
</product-component>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{"name": "Nectar product main", "settings": [{"type": "text", "id": "off_label", "label": "Discount label", "default": "OFF"}, {"type": "text", "id": "image_label", "label": "Thumbnail accessibility label", "default": "View product media"}], "blocks": [{"type": "title", "name": "Title and subtitle", "settings": [{"type": "text", "id": "subtitle", "label": "Subtitle fallback"}]}, {"type": "tabs", "name": "Product information tabs", "limit": 1, "settings": [{"type": "text", "id": "labels", "label": "Five tab labels separated by |", "default": "Description|Ingredients|How to take|FAQ|Lab Reports"}, {"type": "text", "id": "accessibility_label", "label": "Navigation label", "default": "Product information"}, {"type": "text", "id": "report_label", "label": "Report link label", "default": "View lab report"}, {"type": "text", "id": "report_empty", "label": "Report unavailable text", "default": "Contact us for available product documentation."}, {"type": "url", "id": "guidance_link", "label": "Nutritionist link"}, {"type": "text", "id": "guidance_label", "label": "Guidance label", "default": "Talk to a nutritionist"}]}, {"type": "benefits", "name": "Six product benefits", "settings": []}, {"type": "price", "name": "Live variant price", "settings": [{"type": "text", "id": "tax_note", "label": "Tax note", "default": "MRP inclusive of all taxes"}]}, {"type": "offers", "name": "Available offers", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Available Offers"}, {"type": "text", "id": "code_1", "label": "Offer code 1"}, {"type": "text", "id": "text_1", "label": "Offer description 1"}, {"type": "text", "id": "code_2", "label": "Offer code 2"}, {"type": "text", "id": "text_2", "label": "Offer description 2"}, {"type": "text", "id": "code_3", "label": "Offer code 3"}, {"type": "text", "id": "text_3", "label": "Offer description 3"}]}, {"type": "purchase", "name": "Bundles and buy buttons", "limit": 1, "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Select Option"}, {"type": "text", "id": "variant_label", "label": "Variant label", "default": "Select variant"}, {"type": "text", "id": "buy_label", "label": "Bundle label", "default": "Buy"}, {"type": "text", "id": "badge_2", "label": "Second bundle badge", "default": "MOST POPULAR"}, {"type": "text", "id": "badge_3", "label": "Third bundle badge", "default": "BEST VALUE"}, {"type": "text", "id": "add_label", "label": "Add button", "default": "Add to cart"}, {"type": "text", "id": "checkout_label", "label": "Checkout button", "default": "BUY NOW"}, {"type": "text", "id": "sold_out_label", "label": "Sold out text", "default": "Sold out"}, {"type": "text", "id": "adding_label", "label": "Loading text", "default": "Adding\u2026"}, {"type": "text", "id": "added_label", "label": "Success text", "default": "Added to cart"}, {"type": "text", "id": "error_label", "label": "Error text", "default": "Unable to add this item. Please try again."}]}, {"type": "trust", "name": "Trust and delivery row", "settings": [{"type": "text", "id": "text_1", "label": "Text 1"}, {"type": "text", "id": "text_2", "label": "Text 2"}, {"type": "text", "id": "text_3", "label": "Text 3"}]}, {"type": "report", "name": "Product lab report", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Product documentation"}, {"type": "text", "id": "text", "label": "Text", "default": "View the report for this product."}, {"type": "text", "id": "link_label", "label": "Link_Label", "default": "View report"}]}], "presets": [{"name": "Nectar product main"}]}
{% endschema %}
