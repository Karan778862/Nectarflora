{{ 'nf-pdp.css' | asset_url | stylesheet_tag }}
{{ 'nf-pdp-social.css' | asset_url | stylesheet_tag }}

{% assign entries = product.metafields.custom.pdp_reviews.value %}
{% assign card_count = 0 %}
{% capture cards %}
{% if entries != blank %}
{% for item in entries limit: section.settings.max_items %}{% if item.text.value != blank %}<article class="nf-pdp-review"><span class="nf-pdp-quote" aria-hidden="true">“</span>{% if item.rating.value != blank %}<span class="nf-pdp-stars" aria-label="{{ item.rating.value }} out of 5 stars">{% for star in (1..item.rating.value) %}★{% endfor %}</span>{% endif %}<p>{{ item.text.value | escape | newline_to_br }}</p><footer><span aria-hidden="true">{{ item.author.value | slice: 0, 2 | upcase | escape }}</span><strong>{{ item.author.value | escape }}</strong></footer></article>{% assign card_count = card_count | plus: 1 %}{% endif %}{% endfor %}
{% else %}
{% for block in section.blocks %}
{% if block.settings.product.id == product.id and card_count < section.settings.max_items %}{% if block.settings.text != blank %}<article class="nf-pdp-review" {{ block.shopify_attributes }}><span class="nf-pdp-quote" aria-hidden="true">“</span><span class="nf-pdp-stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for star in (1..block.settings.rating) %}★{% endfor %}</span><p>{{ block.settings.text | escape | newline_to_br }}</p><footer><span aria-hidden="true">{{ block.settings.author | slice: 0, 2 | upcase | escape }}</span><strong>{{ block.settings.author | escape }}</strong></footer></article>{% assign card_count = card_count | plus: 1 %}{% endif %}{% endif %}
{% endfor %}
{% endif %}
{% endcapture %}
<section id="nf-reviews-{{ section.id }}" class="nf-pdp-section nf-pdp-section--reviews" style="--nf-section-bg:{{ section.settings.background }};--nf-section-accent:{{ section.settings.accent }};--nf-section-padding:{{ section.settings.padding }}px">
<div class="nf-pdp-shell">
<header class="nf-pdp-section-heading"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.subheading != blank %}<p>{{ section.settings.subheading | escape }}</p>{% endif %}</header>
{% if card_count > 0 %}<div class="nf-pdp-review-grid" aria-label="Customer reviews">{{ cards }}</div>
{% else %}<div class="nf-pdp-social-empty"><p>{{ section.settings.empty_text | escape }}</p></div>{% endif %}
{% if section.settings.review_link != blank %}<a class="nf-pdp-review-link" href="{{ section.settings.review_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}
{% if request.design_mode and card_count == 0 %}<p class="nf-pdp-editor">Add Customer review blocks and select this product, or connect product metafield custom.pdp_reviews. Only entries with feedback are displayed.</p>{% endif %}
</div></section>
{% schema %}
{"name":"Nectar Reviews","settings":[{"type":"paragraph","content":"Product-specific content: connect custom.pdp_reviews in the product editor, or add blocks below and select their product. Connected metafields take priority."},{"type":"text","id":"heading","label":"Heading","default":"Customer Reviews"},{"type":"text","id":"subheading","label":"Subheading"},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"color","id":"accent","label":"Accent","default":"#f7c711"},{"type":"range","id":"padding","label":"Vertical padding","min":24,"max":100,"step":4,"unit":"px","default":60},{"type":"url","id":"review_link","label":"All reviews link"},{"type":"text","id":"button_label","label":"Button label","default":"Read all reviews"},{"type":"text","id":"based_label","label":"Based on label","default":"Based on"},{"type":"text","id":"reviews_label","label":"Reviews label","default":"reviews"},{"type":"range","id":"max_items","label":"Maximum items","min":1,"max":12,"step":1,"default":2},{"type":"text","id":"empty_text","label":"Message when empty","default":"Be the first to share your experience with this product."}],"presets":[{"name":"Nectar Reviews"}],"blocks":[{"type":"review","name":"Customer review","settings":[{"type":"product","id":"product","label":"Product","info":"Required. This entry only appears on the selected product."},{"type":"range","id":"rating","label":"Stars","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"text","label":"Customer feedback"},{"type":"text","id":"author","label":"Customer name"}]}],"max_blocks":24}
{% endschema %}
