{% if section.settings.enabled %}
  <div class="nf-bottom-space" aria-hidden="true"></div>
  <nav class="nf-bottom-nav" aria-label="{{ section.settings.nav_label | escape }}" style="--nf-nav-bg: {{ section.settings.background }}; --nf-nav-active: {{ section.settings.accent }}; --nf-nav-text: {{ section.settings.text_color }};">
    <a href="{{ routes.root_url }}" class="nf-bottom-nav__item" {% if request.page_type == 'index' %}aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10H15v-6H9v6H3Z"/></svg>
      <span>{{ section.settings.home_label | escape }}</span>
    </a>
<a href="{% if section.settings.concern_link != blank %}{{ section.settings.concern_link }}{% else %}{{ routes.root_url }}#nectar-concerns{% endif %}" class="nf-bottom-nav__item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h13M8 12h13M8 19h13"/><circle cx="3" cy="5" r="1"/><circle cx="3" cy="12" r="1"/><circle cx="3" cy="19" r="1"/></svg><span>{{ section.settings.concern_label | escape }}</span></a><a href="{{ section.settings.offer_link | default: routes.all_products_collection_url }}" class="nf-bottom-nav__item nf-bottom-nav__offer" aria-label="{{ section.settings.offer_label | escape }}">{% if section.settings.offer_image != blank %}{{ section.settings.offer_image | image_url: width: 180 | image_tag: widths: '90,180', sizes: '66px', loading: 'lazy' }}{% else %}<span class="nf-bottom-nav__offer-circle"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18v4H3zM5 12v9h14v-9M12 8v13M12 8H8a3 3 0 1 1 3-3l1 3Zm0 0h4a3 3 0 1 0-3-3l-1 3Z"/></svg><strong>{{ section.settings.offer_label | escape }}</strong></span>{% endif %}</a>    <a href="{{ section.settings.category_link | default: routes.collections_url }}" class="nf-bottom-nav__item" {% if request.page_type == 'list-collections' or request.page_type == 'collection' %}aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      <span>{{ section.settings.category_label | escape }}</span>
    </a>
<a href="{{ section.settings.whatsapp_link | default: '/pages/contact' }}" class="nf-bottom-nav__item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.7 7.5L3 21l1.7-4.9a8.5 8.5 0 1 1 15.8-4.5Z"/><path d="M8 7c-2 3 2 7 5 8l2-2-2-1-1 1-3-3 1-1-1-2Z"/></svg><span>{{ section.settings.help_label | escape }}</span></a>
  </nav>
{% endif %}
{% stylesheet %}
  .nf-bottom-nav, .nf-bottom-space { display: none; }
  @media (max-width: 749px) {
    .nf-bottom-space { display: block; height: calc(66px + env(safe-area-inset-bottom, 0px)); flex-shrink: 0; }
    .nf-bottom-nav { position: fixed; bottom: 0; inset-inline: 0; z-index: 90; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0,1fr); padding: 7px 8px calc(7px + env(safe-area-inset-bottom,0px)); background: var(--nf-nav-bg); border-top: 1px solid #dfe8e2; box-shadow: 0 -3px 18px rgb(13 59 43 / 6%); }
    .nf-bottom-nav__item { position: relative; min-width: 0; min-height: 50px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; margin: 0; padding: 4px 2px; border: 0; background: transparent; color: var(--nf-nav-text); font: 500 11px/1.2 Arial,Helvetica,sans-serif; text-decoration: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
    .nf-bottom-nav__item svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .nf-bottom-nav__item[aria-current="page"] { color: var(--nf-nav-active); font-weight: 700; }
    .nf-bottom-nav__item:focus-visible { outline: 2px solid var(--nf-nav-active); outline-offset: -2px; border-radius: 5px; }
    .nf-bottom-nav__badge { position: absolute; top: 0; left: calc(50% + 5px); min-width: 16px; height: 16px; padding: 0 4px; border-radius: 20px; display: grid; place-items: center; background: var(--nf-nav-active); color: white; font-size: 10px; line-height: 1; }
    body:has(.nf-bottom-nav) .nectar-sticky-atc { bottom: calc(66px + env(safe-area-inset-bottom,0px)); }
  }
@media(max-width:749px){.nf-bottom-nav{grid-template-columns:repeat(5,minmax(0,1fr));border-radius:18px 18px 0 0;padding-top:7px;color:#0d443e}.nf-bottom-nav__item[aria-current="page"]{background:#edf2ef;border-radius:28px}.nf-bottom-nav__offer{overflow:visible}.nf-bottom-nav__offer-circle,.nf-bottom-nav__offer>img{width:66px;height:66px;border-radius:50%;margin-top:-27px;object-fit:cover;border:3px solid white;box-shadow:0 2px 8px #103e3026}.nf-bottom-nav__offer-circle{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;background:linear-gradient(145deg,#0e4d38,#17875b);color:#ffdc61;font-size:10px}.nf-bottom-nav__offer-circle svg{width:24px;height:24px}.nectar-header__wishlist{display:flex!important}.nectar-header__right{gap:12px}.nectar-header__logo-text{font-size:clamp(20px,6vw,28px)}}
{% endstylesheet %}
{% javascript %}
  document.addEventListener('keydown', function(event) {
    const tab = event.target.closest('[data-nectar-tab]');
    if (!tab || !['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) return;
    const tabs = Array.from(tab.closest('[role="tablist"]').querySelectorAll('[data-nectar-tab]'));
    let index = tabs.indexOf(tab);
    if (event.key === 'Home') index = 0;
    else if (event.key === 'End') index = tabs.length - 1;
    else index = (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
    event.preventDefault(); tabs[index].click(); tabs[index].focus();
  });
  function nfSyncBottomCount() {
    const badge = document.querySelector('.nectar-header__cart-badge:not(.nectar-wishlist-badge)');
    if (!badge) return;
    document.querySelectorAll('[data-nf-cart-count]').forEach(function(item) { item.textContent = badge.textContent.trim(); });
  }
  document.addEventListener('DOMContentLoaded', function() {
    const badge = document.querySelector('.nectar-header__cart-badge:not(.nectar-wishlist-badge)');
    if (badge) new MutationObserver(nfSyncBottomCount).observe(badge, {childList:true, subtree:true, characterData:true});
    nfSyncBottomCount();
  });
{% endjavascript %}
