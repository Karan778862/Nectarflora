{{ 'section-shop-by-concern.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ShopByConcern-{{ section.id }} .shop-by-concern__heading {
    color: {{ section.settings.heading_color | default: '#0F3D2C' }};
  }

  #ShopByConcern-{{ section.id }} .shop-by-concern__subheading {
    color: {{ section.settings.subheading_color | default: '#64748B' }};
  }
{%- endstyle -%}

{%- liquid
  assign concern_blocks_count = 0
  assign trending_blocks_count = 0

  for block in section.blocks
    if block.type == 'concern_item'
      assign concern_blocks_count = concern_blocks_count | plus: 1
    elsif block.type == 'trending_tag'
      assign trending_blocks_count = trending_blocks_count | plus: 1
    endif
  endfor
-%}

<section
  id="ShopByConcern-{{ section.id }}"
  class="shop-by-concern section-{{ section.id }}-padding"
  aria-label="{{ section.settings.heading | default: 'Shop by Concern' }}"
>
  <div class="shop-by-concern__container">
    <!-- Section Heading & Subheading -->
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="shop-by-concern__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="shop-by-concern__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="shop-by-concern__subheading">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Horizontal List of 8 Circular Concern Items -->
    <div class="shop-by-concern__grid" role="list">
      {%- if concern_blocks_count > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'concern_item' -%}
            {%- assign item_color = block.settings.bottle_color | default: '#1C6747' -%}
            {%- assign item_bg = block.settings.circle_bg_color | default: '#E8F6ED' -%}
            <a
              href="{{ block.settings.link | default: routes.all_products_collection_url }}"
              class="shop-by-concern__item"
              role="listitem"
              {{ block.shopify_attributes }}
            >
              <div class="shop-by-concern__circle" style="background-color: {{ item_bg }};">
                {%- if block.settings.custom_image != blank -%}
                  {{
                    block.settings.custom_image
                    | image_url: width: 200
                    | image_tag:
                      class: 'shop-by-concern__custom-img',
                      loading: 'lazy',
                      alt: block.settings.title | escape
                  }}
                {%- else -%}
                  <!-- Clean Flat Minimalist Bottle Silhouette matching Image 2 -->
                  <svg
                    class="shop-by-concern__bottle-svg"
                    viewBox="0 0 54 72"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <!-- Dark Cap -->
                    <rect x="20" y="4" width="14" height="7" rx="2" fill="#0D3B2B" />
                    <rect x="22" y="11" width="10" height="3" fill="#0D3B2B" />
                    <!-- Bottle Body -->
                    <rect x="10" y="14" width="34" height="54" rx="8" fill="{{ item_color }}" />
                    <!-- Center White Label -->
                    <rect x="15" y="27" width="24" height="28" rx="5" fill="#FFFFFF" />
                  </svg>
                {%- endif -%}
              </div>
              <span class="shop-by-concern__title">
                {{ block.settings.title | escape }}
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Default 8 Reference Concern Items matching Image 2 -->
        <!-- 1: Skin -->
        <a href="/collections/all" class="shop-by-concern__item" role="listitem">
          <div class="shop-by-concern__circle" style="background-color: #E8F6ED;">
            <svg class="shop-by-concern__bottle-svg" viewBox="0 0 54 72" fill="none">
              <rect x="20" y="4" width="14" height="7" rx="2" fill="#0D3B2B" />
              <rect x="22" y="11" width="10" height="3" fill="#0D3B2B" />
              <rect x="10" y="14" width="34" height="54" rx="8" fill="#1C6747" />
              <rect x="15" y="27" width="24" height="28" rx="5" fill="#FFFFFF" />
            </svg>
          </div>
          <span class="shop-by-concern__title">Skin</span>
        </a>

        <!-- 2: Hair -->
        <a href="/collections/all" class="shop-by-concern__item" role="listitem">
          <div class="shop-by-concern__circle" style="background-color: #E8F6ED;">
            <svg class="shop-by-concern__bottle-svg" viewBox="0 0 54 72" fill="none">
              <rect x="20" y="4" width="14" height="7" rx="2" fill="#0D3B2B" />
              <rect x="22" y="11" width="10" height="3" fill="#0D3B2B" />
              <rect x="10" y="14" width="34" height="54" rx="8" fill="#E5A000" />
              <rect x="15" y="27" width="24" height="28" rx="5" fill="#FFFFFF" />
            </svg>
          </div>
          <span class="shop-by-concern__title">Hair</span>
        </a>

        <!-- 3: Sleep & Stress -->
        <a href="/collections/all" class="shop-by-concern__item" role="listitem">
          <div class="shop-by-concern__circle" style="background-color: #E8F6ED;">
            <svg class="shop-by-concern__bottle-svg" viewBox="0 0 54 72" fill="none">
              <rect x="20" y="4" width="14" height="7" rx="2" fill="#0D3B2B" />
              <rect x="22" y="11" width="10" height="3" fill="#0D3B2B" />
              <rect x="10" y="14" width="34" height="54" rx="8" fill="#583F8A" />
              <rect x="15" y="27" width="24" height="28" rx="5" fill="#FFFFFF" />
            </svg>
          </div>
          <span class="shop-by-concern__title">Sleep & Stress</span>
        </a>

        <!-- 4: Liver & Digestion -->
        <a href="/collections/all" class="shop-by-concern__item" role="listitem">
          <div class="shop-by-concern__circle" style="background-color: #E8F6ED;">
            <svg class="shop-by-concern__bottle-svg" viewBox="0 0 54 72" fill="none">
              <rect x="20" y="4" width="14" height="7" rx="2" fill="#0D3B2B" />
              <rect x="22" y="11" width="10" height="3" fill="#0D3B2B" />
              <rect x="10" y="14" width="34" height="54" rx="8" fill="#A85324" />
              <rect x="15" y="27" width="24" height="28" rx="5" fill="#FFFFFF" />
            </svg>
          </div>
          <span class="shop-by-concern__title">Liver & Digestion</span>
        </a>

        <!-- 5: Brain -->
        <a href="/collections/all" class="shop-by-concern__item" role="listitem">
          <div class="shop-by-concern__circle" style="background-color: #E8F6ED;">
            <svg class="shop-by-concern__bottle-svg" viewBox="0 0 54 72" fill="none">
              <rect x="20" y="4" width="14" height="7" rx="2" fill="#0D3B2B" />
              <rect x="22" y="11" width="10" height="3" fill="#0D3B2B" />
              <rect x="10" y="14" width="34" height="54" rx="8" fill="#15657B" />
              <rect x="15" y="27" width="24" height="28" rx="5" fill="#FFFFFF" />
            </svg>
          </div>
          <span class="shop-by-concern__title">Brain</span>
        </a>

        <!-- 6: Women Health -->
        <a href="/collections/all" class="shop-by-concern__item" role="listitem">
          <div class="shop-by-concern__circle" style="background-color: #E8F6ED;">
            <svg class="shop-by-concern__bottle-svg" viewBox="0 0 54 72" fill="none">
              <rect x="20" y="4" width="14" height="7" rx="2" fill="#0D3B2B" />
              <rect x="22" y="11" width="10" height="3" fill="#0D3B2B" />
              <rect x="10" y="14" width="34" height="54" rx="8" fill="#C01E5B" />
              <rect x="15" y="27" width="24" height="28" rx="5" fill="#FFFFFF" />
            </svg>
          </div>
          <span class="shop-by-concern__title">Women Health</span>
        </a>

        <!-- 7: Weight -->
        <a href="/collections/all" class="shop-by-concern__item" role="listitem">
          <div class="shop-by-concern__circle" style="background-color: #E8F6ED;">
            <svg class="shop-by-concern__bottle-svg" viewBox="0 0 54 72" fill="none">
              <rect x="20" y="4" width="14" height="7" rx="2" fill="#0D3B2B" />
              <rect x="22" y="11" width="10" height="3" fill="#0D3B2B" />
              <rect x="10" y="14" width="34" height="54" rx="8" fill="#289E49" />
              <rect x="15" y="27" width="24" height="28" rx="5" fill="#FFFFFF" />
            </svg>
          </div>
          <span class="shop-by-concern__title">Weight</span>
        </a>

        <!-- 8: Immunity -->
        <a href="/collections/all" class="shop-by-concern__item" role="listitem">
          <div class="shop-by-concern__circle" style="background-color: #E8F6ED;">
            <svg class="shop-by-concern__bottle-svg" viewBox="0 0 54 72" fill="none">
              <rect x="20" y="4" width="14" height="7" rx="2" fill="#0D3B2B" />
              <rect x="22" y="11" width="10" height="3" fill="#0D3B2B" />
              <rect x="10" y="14" width="34" height="54" rx="8" fill="#E65A28" />
              <rect x="15" y="27" width="24" height="28" rx="5" fill="#FFFFFF" />
            </svg>
          </div>
          <span class="shop-by-concern__title">Immunity</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Trending Searches Area matching Image 2 -->
    {%- if section.settings.show_trending -%}
      <div class="shop-by-concern__trending-wrap">
        <span class="shop-by-concern__trending-label">
          {{ section.settings.trending_label | default: 'Trending:' }}
        </span>

        {%- if trending_blocks_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'trending_tag' -%}
              {%- capture default_search_url -%}{{ routes.search_url }}?q={{ block.settings.title | url_encode }}{%- endcapture -%}
              <a
                href="{{ block.settings.link | default: default_search_url }}"
                class="shop-by-concern__pill"
                {{ block.shopify_attributes }}
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span>{{ block.settings.title | escape }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <!-- Default 10 Reference Trending Tags matching Image 2 -->
          {%- assign default_tags = "KSM-66 Ashwagandha,Myo-Inositol,Shatavari,Milk Thistle,NAC,Liposomal Glutathione,Trans-Resveratrol,Saw Palmetto,Biotin,Magnesium Bisglycinate" | split: "," -%}
          {%- for tag in default_tags -%}
            <a
              href="{{ routes.search_url }}?q={{ tag | url_encode }}"
              class="shop-by-concern__pill"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <span>{{ tag }}</span>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by Concern",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Concern"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find the right support for your wellness goals"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0F3D2C"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#64748B"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Trending Section"
    },
    {
      "type": "checkbox",
      "id": "show_trending",
      "label": "Show Trending Searches",
      "default": true
    },
    {
      "type": "text",
      "id": "trending_label",
      "label": "Trending Label",
      "default": "Trending:"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "concern_item",
      "name": "Concern Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Concern Name",
          "default": "Skin"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image / 3D Icon (Optional)"
        },
        {
          "type": "color",
          "id": "bottle_color",
          "label": "Bottle Color (When custom image is empty)",
          "default": "#1C6747"
        },
        {
          "type": "color",
          "id": "circle_bg_color",
          "label": "Circle Background Color",
          "default": "#E8F6ED"
        }
      ]
    },
    {
      "type": "trending_tag",
      "name": "Trending Search Tag",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tag Title",
          "default": "KSM-66 Ashwagandha"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link (Optional - defaults to search)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Concern",
      "blocks": [
        { "type": "concern_item", "settings": { "title": "Skin", "bottle_color": "#1C6747" } },
        { "type": "concern_item", "settings": { "title": "Hair", "bottle_color": "#E5A000" } },
        { "type": "concern_item", "settings": { "title": "Sleep & Stress", "bottle_color": "#583F8A" } },
        { "type": "concern_item", "settings": { "title": "Liver & Digestion", "bottle_color": "#A85324" } },
        { "type": "concern_item", "settings": { "title": "Brain", "bottle_color": "#15657B" } },
        { "type": "concern_item", "settings": { "title": "Women Health", "bottle_color": "#C01E5B" } },
        { "type": "concern_item", "settings": { "title": "Weight", "bottle_color": "#289E49" } },
        { "type": "concern_item", "settings": { "title": "Immunity", "bottle_color": "#E65A28" } },
        { "type": "trending_tag", "settings": { "title": "KSM-66 Ashwagandha" } },
        { "type": "trending_tag", "settings": { "title": "Myo-Inositol" } },
        { "type": "trending_tag", "settings": { "title": "Shatavari" } },
        { "type": "trending_tag", "settings": { "title": "Milk Thistle" } },
        { "type": "trending_tag", "settings": { "title": "NAC" } },
        { "type": "trending_tag", "settings": { "title": "Liposomal Glutathione" } },
        { "type": "trending_tag", "settings": { "title": "Trans-Resveratrol" } },
        { "type": "trending_tag", "settings": { "title": "Saw Palmetto" } },
        { "type": "trending_tag", "settings": { "title": "Biotin" } },
        { "type": "trending_tag", "settings": { "title": "Magnesium Bisglycinate" } }
      ]
    }
  ]
}
{% endschema %}
