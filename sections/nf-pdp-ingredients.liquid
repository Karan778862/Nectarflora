{{ 'nf-pdp.css' | asset_url | stylesheet_tag }}
{% assign entries = product.metafields.custom.pdp_ingredients.value %}
{% if entries != blank or request.design_mode %}
<section class="nf-pdp-section nf-pdp-section--ingredients" style="--nf-section-bg:{{ section.settings.background }};--nf-section-accent:{{ section.settings.accent }};--nf-section-padding:{{ section.settings.padding }}px">
<div class="nf-pdp-shell">
<div class="nf-pdp-split"><div><h2>{{ section.settings.heading | escape }}</h2><ul class="nf-pdp-ingredients">{% for item in entries limit: section.settings.max_items %}<li><span style="background:{{ item.color.value | default: '#216f87' }}">{{ item.initial.value | default: item.title.value | slice: 0 | upcase | escape }}</span><div><h3>{{ item.title.value | escape }}</h3>{% if item.text.value != blank %}<p>{{ item.text.value | escape }}</p>{% endif %}</div></li>{% endfor %}</ul></div><div class="nf-pdp-ingredient-visual" style="background:{{ product.metafields.custom.color_hex.value | default: '#c7762e' }}">{% assign ingredient_image = product.metafields.custom.pdp_ingredients_image.value | default: product.featured_image %}{% if ingredient_image != blank %}{{ ingredient_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360,540,750,1000', sizes: '(min-width: 750px) 42vw, 90vw' }}{% endif %}</div></div>{% if entries == blank and request.design_mode %}<p class="nf-pdp-editor">Connect product metafield custom.pdp_ingredients to show this section. Add product-specific entries in the product editor.</p>{% endif %}</div></section>{% endif %}
{% schema %}
{"name": "Nectar Ingredients", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Clinically Studied Ingredients"}, {"type": "text", "id": "subheading", "label": "Subheading"}, {"type": "color", "id": "background", "label": "Background", "default": "#ffffff"}, {"type": "color", "id": "accent", "label": "Accent", "default": "#f7c711"}, {"type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 60}, {"type": "range", "id": "max_items", "label": "Maximum items", "min": 1, "max": 12, "step": 1, "default": 4}], "presets": [{"name": "Nectar Ingredients"}]}
{% endschema %}