{%- doc -%}
  Nectarflora Product Page Dynamic Blocks
  Renders custom blocks for main-product.liquid with dynamic metafield support.
{%- enddoc -%}

{%- assign block_type = forced_type | default: block.type -%}
{%- case block_type -%}

  {%- when 'subtitle' -%}
    {%- liquid
      assign subtitle_text = block.settings.text
      if subtitle_text == blank
        assign subtitle_text = product.metafields.custom.subtitle.value | default: product.metafields.custom.subtitle | default: 'Advance Skin Wellness Formula'
      endif
    -%}
    {%- if subtitle_text != blank -%}
      <div class="nectar-product-subtitle" {{ block.shopify_attributes }}>
        {{ subtitle_text }}
      </div>
    {%- endif -%}

  {%- when 'nectar_rating', 'rating' -%}
    <div class="nectar-product-rating-wrap" {{ block.shopify_attributes }}>
      <div class="nectar-rating-stars">★★★★★</div>
      <span class="nectar-rating-score">{{ block.settings.score | default: '4.6' }}/5</span>
      <span class="nectar-rating-count">({{ block.settings.reviews_count | default: '128' }})</span>
    </div>

  {%- when 'product_tabs', 'description' -%}
    <div class="nectar-product-tabs-wrap" id="NectarTabs-{{ section.id }}" {{ block.shopify_attributes }}>
      <div class="nectar-tabs-nav" role="tablist">
        <button type="button" class="nectar-tab-btn is-active" data-tab-target="desc-{{ section.id }}" role="tab" aria-selected="true">
          {{ block.settings.tab_1_title | default: 'Description' }}
        </button>
        <button type="button" class="nectar-tab-btn" data-tab-target="ingr-{{ section.id }}" role="tab" aria-selected="false">
          {{ block.settings.tab_2_title | default: 'Ingredients' }}
        </button>
        <button type="button" class="nectar-tab-btn" data-tab-target="take-{{ section.id }}" role="tab" aria-selected="false">
          {{ block.settings.tab_3_title | default: 'How to take' }}
        </button>
        <button type="button" class="nectar-tab-btn" data-tab-target="faq-{{ section.id }}" role="tab" aria-selected="false">
          {{ block.settings.tab_4_title | default: 'FAQ' }}
        </button>
        <button type="button" class="nectar-tab-btn" data-tab-target="lab-{{ section.id }}" role="tab" aria-selected="false">
          {{ block.settings.tab_5_title | default: 'Lab Reports' }}
        </button>
      </div>

      <!-- Description Panel -->
      <div class="nectar-tab-panel is-active" id="desc-{{ section.id }}" role="tabpanel">
        <div class="nectar-desc-content-wrap">
          <!-- Talk to a Nutritionist Floating Pill -->
          <a
            href="https://wa.me/919999999999?text=Hi%20Nectarflora,%20I%20would%20like%20to%20talk%20to%20a%20nutritionist%20about%20Age%20Well."
            target="_blank"
            rel="noopener"
            class="nectar-nutritionist-floating-pill"
            title="Chat with certified nutritionist"
          >
            <div class="nectar-nutritionist-avatar-wrap">
              <div class="nectar-nutritionist-avatar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0D3B2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <span class="nectar-nutritionist-online-dot"></span>
            </div>
            <div class="nectar-nutritionist-text-col">
              <span class="nectar-nutritionist-heading">Talk to a Nutritionist</span>
              <span class="nectar-nutritionist-sub">Free &bull; Online now</span>
            </div>
          </a>

          {%- if product.description != blank -%}
            <div class="product__description rte">
              {{ product.description }}
            </div>
          {%- else -%}
            <p>NectarFlora Age Well is an advanced skin wellness formula delivering 500 mg of Liposomal Glutathione (90%), encapsulated in liposomal technology for higher bioavailability and superior cellular absorption. Enriched with Trans-Resveratrol, Grape Seed, Green Tea and Pine Bark extracts, Liposomal Vitamin C, Liposomal CoQ10, Hyaluronic Acid and Astaxanthin, it supports skin brightness, helps reduce pigmentation and protects cells from oxidative stress. Clean, third-party tested and free from added sugar, preservatives, artificial colours or flavours.</p>
          {%- endif -%}
        </div>
      </div>

      <!-- Ingredients Panel (metafield custom.ingredients) -->
      <div class="nectar-tab-panel" id="ingr-{{ section.id }}" role="tabpanel">
        {%- if product.metafields.custom.ingredients != blank -%}
          <div class="rte">
            {{ product.metafields.custom.ingredients | metafield_tag }}
          </div>
        {%- else -%}
          <div class="nectar-ingredients-list">
            <div class="nectar-ingredient-card">
              <div class="nectar-ingredient-header">
                <span class="nectar-ingredient-name">Setria® Liposomal Glutathione</span>
                <span class="nectar-ingredient-dose">500 mg (90% Purity)</span>
              </div>
              <p class="nectar-ingredient-desc">Master cellular antioxidant with liposomal bilayer protection for superior absorption and melanin regulation.</p>
            </div>

            <div class="nectar-ingredient-card">
              <div class="nectar-ingredient-header">
                <span class="nectar-ingredient-name">Trans-Resveratrol</span>
                <span class="nectar-ingredient-dose">98% Pure Japanese Knotweed</span>
              </div>
              <p class="nectar-ingredient-desc">Activates longevity sirtuin pathways and shields skin cells from oxidative UV damage.</p>
            </div>

            <div class="nectar-ingredient-card">
              <div class="nectar-ingredient-header">
                <span class="nectar-ingredient-name">French Pine Bark &amp; Grape Seed Extract</span>
                <span class="nectar-ingredient-dose">Standardized OPCs</span>
              </div>
              <p class="nectar-ingredient-desc">High-potency bioflavonoids enhancing dermal micro-circulation and collagen synthesis.</p>
            </div>

            <div class="nectar-ingredient-card">
              <div class="nectar-ingredient-header">
                <span class="nectar-ingredient-name">Liposomal Vitamin C &amp; CoQ10</span>
                <span class="nectar-ingredient-dose">Cellular Energy Co-factors</span>
              </div>
              <p class="nectar-ingredient-desc">Supports ATP cellular renewal and collagen matrix formation against photoageing.</p>
            </div>

            <div class="nectar-ingredient-card">
              <div class="nectar-ingredient-header">
                <span class="nectar-ingredient-name">Low-Molecular Hyaluronic Acid</span>
                <span class="nectar-ingredient-dose">Deep Dermis Moisture</span>
              </div>
              <p class="nectar-ingredient-desc">Binds up to 1,000x its weight in water for cellular hydration, plumpness, and elasticity.</p>
            </div>

            <div class="nectar-ingredient-card">
              <div class="nectar-ingredient-header">
                <span class="nectar-ingredient-name">Natural Astaxanthin</span>
                <span class="nectar-ingredient-dose">Haematococcus Microalgae</span>
              </div>
              <p class="nectar-ingredient-desc">6,000x more potent than Vitamin C in combating free radicals and environmental stress.</p>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- How to take Panel (metafield custom.how_to_take) -->
      <div class="nectar-tab-panel" id="take-{{ section.id }}" role="tabpanel">
        {%- if product.metafields.custom.how_to_take != blank -%}
          <div class="rte">
            {{ product.metafields.custom.how_to_take | metafield_tag }}
          </div>
        {%- else -%}
          <div class="nectar-usage-steps">
            <div class="nectar-usage-step">
              <div class="nectar-usage-num">1</div>
              <div class="nectar-usage-info">
                <strong>Recommended Dosage:</strong>
                <p>Take 1 to 2 capsules daily.</p>
              </div>
            </div>
            <div class="nectar-usage-step">
              <div class="nectar-usage-num">2</div>
              <div class="nectar-usage-info">
                <strong>Ideal Timing:</strong>
                <p>Consume after breakfast or your first morning meal with a full glass of water.</p>
              </div>
            </div>
            <div class="nectar-usage-step">
              <div class="nectar-usage-num">3</div>
              <div class="nectar-usage-info">
                <strong>Consistency:</strong>
                <p>Maintain consistent daily intake for 60 to 90 days for peak cellular renewal and lasting glow.</p>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- FAQ Panel (metafield custom.faqs) -->
      <div class="nectar-tab-panel" id="faq-{{ section.id }}" role="tabpanel">
        {%- if product.metafields.custom.faqs != blank -%}
          <div class="rte">
            {{ product.metafields.custom.faqs | metafield_tag }}
          </div>
        {%- else -%}
          <div class="nectar-faq-accordion" data-nectar-accordion>
            <div class="nectar-faq-item is-open">
              <button type="button" class="nectar-faq-question" aria-expanded="true">
                <span>When can I expect to see visible results?</span>
                <span class="nectar-faq-toggle-icon">−</span>
              </button>
              <div class="nectar-faq-answer" style="display: block;">
                <p>Most users report noticeable skin hydration and morning radiance within 3–4 weeks of daily use. Significant reduction in pigmentation, melasma spots, and enhanced skin elasticity are clinically documented after 8–12 weeks of continuous supplementation.</p>
              </div>
            </div>

            <div class="nectar-faq-item">
              <button type="button" class="nectar-faq-question" aria-expanded="false">
                <span>What makes Liposomal Glutathione superior to regular glutathione?</span>
                <span class="nectar-faq-toggle-icon">+</span>
              </button>
              <div class="nectar-faq-answer">
                <p>Regular glutathione is largely degraded by harsh stomach acids before cellular absorption. Our Setria® Liposomal technology encapsulates 500mg pure glutathione inside natural lipid bilayers, ensuring up to 90% bioavailability directly into your cells.</p>
              </div>
            </div>

            <div class="nectar-faq-item">
              <button type="button" class="nectar-faq-question" aria-expanded="false">
                <span>How and when should I take Age Well capsules?</span>
                <span class="nectar-faq-toggle-icon">+</span>
              </button>
              <div class="nectar-faq-answer">
                <p>Take 1 to 2 capsules daily with a full glass of water, ideally after breakfast or your first morning meal. For peak anti-ageing and antioxidant benefits, consistent daily intake for 60–90 days is strongly recommended.</p>
              </div>
            </div>

            <div class="nectar-faq-item">
              <button type="button" class="nectar-faq-question" aria-expanded="false">
                <span>Are there any side effects or synthetic fillers?</span>
                <span class="nectar-faq-toggle-icon">+</span>
              </button>
              <div class="nectar-faq-answer">
                <p>NectarFlora Age Well is 100% vegetarian, non-GMO, and formulated with zero added sugar, synthetic preservatives, artificial colours, or fillers. Every production batch undergoes strict third-party NABL-accredited safety and purity screening.</p>
              </div>
            </div>

            <div class="nectar-faq-item">
              <button type="button" class="nectar-faq-question" aria-expanded="false">
                <span>Can I take Age Well alongside my other skincare &amp; vitamins?</span>
                <span class="nectar-faq-toggle-icon">+</span>
              </button>
              <div class="nectar-faq-answer">
                <p>Yes, absolutely. Age Well works from within and complements topical skincare (Vitamin C serums, Niacinamide, Retinol) as well as daily wellness supplements like Omega-3, Collagen, and multivitamins.</p>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Lab Reports Panel -->
      <div class="nectar-tab-panel" id="lab-{{ section.id }}" role="tabpanel">
        <div class="nectar-lab-panel-card">
          <div class="nectar-lab-panel-badge">NABL Certified &bull; 100% Purity Verified</div>
          <div class="nectar-lab-panel-grid">
            <div class="nectar-lab-panel-item">
              <span class="nectar-lab-panel-label">Current Batch:</span>
              <span class="nectar-lab-panel-val">NF-AW-2026-08</span>
            </div>
            <div class="nectar-lab-panel-item">
              <span class="nectar-lab-panel-label">Active Assay:</span>
              <span class="nectar-lab-panel-val" style="color: #16A34A;">99.4% (Passed)</span>
            </div>
            <div class="nectar-lab-panel-item">
              <span class="nectar-lab-panel-label">Heavy Metals:</span>
              <span class="nectar-lab-panel-val" style="color: #16A34A;">Below Limit (Safe)</span>
            </div>
            <div class="nectar-lab-panel-item">
              <span class="nectar-lab-panel-label">Microbial Screen:</span>
              <span class="nectar-lab-panel-val" style="color: #16A34A;">Clean &bull; Negative</span>
            </div>
          </div>
          <a href="#lab-test" class="nectar-lab-btn" style="display: inline-block; margin-top: 14px;">View Batch Certificate PDF</a>
        </div>
      </div>
    </div>

  {%- when 'clinical_claims' -%}
    <div class="nectar-clinical-disclaimer" {{ block.shopify_attributes }}>
      {{ block.settings.text | default: 'Claims based on clinically studied ingredients, not the product.' }}
    </div>

  {%- when 'key_benefits' -%}
    <div class="nectar-benefits-grid" {{ block.shopify_attributes }}>
      <!-- 1: Improves Skin Brightness -->
      <div class="nectar-benefit-item">
        <div class="nectar-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3c0 4.2-3 7.8-7.5 9 4.5 1.2 7.5 4.8 7.5 9 0-4.2 3-7.8 7.5-9-4.5-1.2-7.5-4.8-7.5-9z"/>
          </svg>
        </div>
        <div class="nectar-benefit-text">Improves Skin<br>Brightness¹</div>
      </div>

      <!-- 2: Anti-Ageing Support -->
      <div class="nectar-benefit-item">
        <div class="nectar-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 4h12M6 20h12M7 4.5c0 3.8 3 6.2 5 7.5-2 1.3-5 3.7-5 7.5M17 4.5c0 3.8-3 6.2-5 7.5 2 1.3 5 3.7 5 7.5"/>
          </svg>
        </div>
        <div class="nectar-benefit-text">Anti-Ageing<br>Support²</div>
      </div>

      <!-- 3: Supports Cellular Health -->
      <div class="nectar-benefit-item">
        <div class="nectar-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6c3 1.5 5 4.5 8 6s5 4.5 8 6"/>
            <path d="M20 6c-3 1.5-5 4.5-8 6s-5 4.5-8 6"/>
            <line x1="7.5" y1="7.8" x2="6" y2="10.8"/>
            <line x1="16.5" y1="13.2" x2="18" y2="16.2"/>
            <line x1="10" y1="10.5" x2="14" y2="13.5"/>
          </svg>
        </div>
        <div class="nectar-benefit-text">Supports Cellular<br>Health³</div>
      </div>

      <!-- 4: Helps Reduce Pigmentation -->
      <div class="nectar-benefit-item">
        <div class="nectar-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7V5a1 1 0 0 1 1-1h2M17 4h2a1 1 0 0 1 1 1v2M4 17v2a1 1 0 0 0 1 1h2M17 20h2a1 1 0 0 0 1-1v-2"/>
            <circle cx="9" cy="11" r="1" fill="currentColor"/>
            <circle cx="15" cy="11" r="1" fill="currentColor"/>
            <path d="M9.5 14.5c.8.8 1.6 1.1 2.5 1.1s1.7-.3 2.5-1.1"/>
          </svg>
        </div>
        <div class="nectar-benefit-text">Helps Reduce<br>Pigmentation⁴</div>
      </div>

      <!-- 5: Deep Skin Hydration -->
      <div class="nectar-benefit-item">
        <div class="nectar-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a9 9 0 0 0-7 9.5c0 4.2 3.3 7.5 7 7.5s7-3.3 7-7.5A9 9 0 0 0 12 3z"/>
            <path d="M12 9.5a4 4 0 0 0-3 3.8c0 1.8 1.4 3.2 3 3.2s3-1.4 3-3.2A4 4 0 0 0 12 9.5z"/>
          </svg>
        </div>
        <div class="nectar-benefit-text">Deep Skin<br>Hydration⁵</div>
      </div>

      <!-- 6: Antioxidant Protection -->
      <div class="nectar-benefit-item">
        <div class="nectar-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l7 3v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z"/>
            <polyline points="9 12 11.2 14.2 15.5 9.8"/>
          </svg>
        </div>
        <div class="nectar-benefit-text">Antioxidant<br>Protection⁶</div>
      </div>
    </div>

  {%- when 'nectar_price', 'price' -%}
    {%- liquid
      assign current_variant = product.selected_or_first_available_variant
      assign current_price = current_variant.price
      assign compare_price = current_variant.compare_at_price
      if current_price == 0 or current_price == nil
        assign current_price_display = '₹1,999'
        assign compare_price_display = '₹2,199'
        assign discount_percent = 9
      else
        assign current_price_display = current_price | money
        assign compare_price_display = compare_price | money
        if compare_price > current_price
          assign discount_percent = compare_price | minus: current_price | times: 100.0 | divided_by: compare_price | round
        else
          assign discount_percent = 9
        endif
      endif
    -%}
    <div class="nectar-price-block" id="NectarPrice-{{ section.id }}" {{ block.shopify_attributes }}>
      <div class="nectar-price-row">
        <span class="nectar-price-current" data-price-current>{{ current_price_display }}</span>
        {%- if compare_price_display != blank and compare_price_display != current_price_display -%}
          <span class="nectar-price-compare" data-price-compare>{{ compare_price_display }}</span>
          <span class="nectar-price-discount" data-price-discount>{{ discount_percent }}% off</span>
        {%- endif -%}
      </div>
      <div class="nectar-price-tax-note">(MRP Inclusive of all taxes)</div>
    </div>

  {%- when 'available_offers' -%}
    <div class="nectar-offers-box" {{ block.shopify_attributes }}>
      <div class="nectar-offers-header">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 12 20 22 4 22 4 12"/>
          <rect x="2" y="7" width="20" height="5"/>
          <line x1="12" y1="22" x2="12" y2="7"/>
          <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
          <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
        </svg>
        <span>{{ block.settings.heading | default: 'Available Offers' }}</span>
      </div>
      <div class="nectar-offers-list">
        <div class="nectar-offer-item">
          <span class="nectar-offer-badge" data-coupon="BUY2GET1" title="Click to copy">BUY2GET1</span>
          <span>{{ block.settings.offer_1_text | default: 'Buy any 2, get 1 free' }}</span>
        </div>
        <div class="nectar-offer-item">
          <span class="nectar-offer-badge" data-coupon="FIRST10" title="Click to copy">FIRST10</span>
          <span>{{ block.settings.offer_2_text | default: 'Extra 10% off on your first order' }}</span>
        </div>
        <div class="nectar-offer-item">
          <span class="nectar-offer-badge" data-coupon="FREESHIP" title="Click to copy">FREESHIP</span>
          <span>{{ block.settings.offer_3_text | default: 'Free shipping on orders above ₹499' }}</span>
        </div>
      </div>
    </div>

  {%- when 'bundle_selector', 'quantity_selector', 'variant_picker' -%}
    {%- liquid
      assign single_price = product.selected_or_first_available_variant.price
      if single_price == 0 or single_price == nil
        assign single_price = 199900
        assign single_price_display = '₹1,999'
        assign price_2 = 379800
        assign price_3 = 539700
        assign price_2_display = '₹3,798'
        assign price_3_display = '₹5,397'
      else
        assign single_price_display = single_price | money
        assign price_2 = single_price | times: 2 | minus: 20000
        assign price_3 = single_price | times: 3 | minus: 60000
        if price_2 < single_price
          assign price_2 = single_price | times: 2
        endif
        if price_3 < single_price
          assign price_3 = single_price | times: 3
        endif
        assign price_2_display = price_2 | money
        assign price_3_display = price_3 | money
      endif
    -%}
    <div class="nectar-bundle-selector" id="NectarBundles-{{ section.id }}" {{ block.shopify_attributes }}>
      <div class="nectar-bundle-heading">{{ block.settings.heading | default: 'Select Option' }}</div>
      
      <div class="nectar-bundle-cards-grid">
        <!-- Option 1: Buy 1 -->
        <div class="nectar-bundle-card is-active" data-qty="1" data-price="{{ single_price }}">
          <div class="nectar-bundle-image-area">
            {%- if product.featured_image != blank -%}
              <img src="{{ product.featured_image | image_url: width: 160 }}" alt="{{ product.title | escape }}" loading="lazy" width="80" height="80">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="nectar-bundle-card-bottom">
            <div class="nectar-bundle-name">Buy 1</div>
            <div class="nectar-bundle-price">{{ single_price_display }}</div>
          </div>
        </div>

        <!-- Option 2: Buy 2 (Most Popular) -->
        <div class="nectar-bundle-card" data-qty="2" data-price="{{ price_2 }}">
          <div class="nectar-bundle-image-area">
            {%- if product.featured_image != blank -%}
              <div style="display: flex; gap: 4px; justify-content: center;">
                <img src="{{ product.featured_image | image_url: width: 140 }}" alt="{{ product.title | escape }}" loading="lazy" width="55" height="55">
                <img src="{{ product.featured_image | image_url: width: 140 }}" alt="{{ product.title | escape }}" loading="lazy" width="55" height="55">
              </div>
            {%- endif -%}
            <div class="nectar-bundle-ribbon">MOST POPULAR</div>
          </div>
          <div class="nectar-bundle-card-bottom">
            <div class="nectar-bundle-name">Buy 2</div>
            <div class="nectar-bundle-price">{{ price_2_display }} &bull; Save ₹600</div>
          </div>
        </div>

        <!-- Option 3: Buy 3 (Best Value) -->
        <div class="nectar-bundle-card" data-qty="3" data-price="{{ price_3 }}">
          <div class="nectar-bundle-image-area">
            {%- if product.featured_image != blank -%}
              <div style="display: flex; gap: 2px; justify-content: center;">
                <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy" width="45" height="45">
                <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy" width="45" height="45">
                <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy" width="45" height="45">
              </div>
            {%- endif -%}
            <div class="nectar-bundle-ribbon">BEST VALUE</div>
          </div>
          <div class="nectar-bundle-card-bottom">
            <div class="nectar-bundle-name">Buy 3</div>
            <div class="nectar-bundle-price">{{ price_3_display }} &bull; Save ₹1,200</div>
          </div>
        </div>
      </div>
    </div>

  {%- when 'nectar_buy_buttons', 'buy_buttons' -%}
    <div class="nectar-buy-buttons-wrap" id="NectarBuyButtons-{{ section.id }}" {{ block.shopify_attributes }}>
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-nectar-variant-id>
      <input type="hidden" name="quantity" value="1" data-nectar-quantity-input>

      <!-- Add to cart -->
      <button type="button" class="nectar-btn-add-to-cart" data-nectar-add-to-cart>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span>{{ block.settings.add_to_cart_label | default: 'Add to cart' }}</span>
      </button>

      <!-- BUY NOW with payment badges -->
      <button type="button" class="nectar-btn-buy-now" data-nectar-buy-now>
        <span>{{ block.settings.buy_now_label | default: 'BUY NOW' }}</span>
        <div class="nectar-payment-pill-icons">
          <span class="nectar-pay-badge nectar-pay-badge--gpay">GPay</span>
          <span class="nectar-pay-badge nectar-pay-badge--phonepe">Pe</span>
          <span class="nectar-pay-badge nectar-pay-badge--paytm">Paytm</span>
          <span style="font-size: 16px; margin-left: 2px;">›</span>
        </div>
      </button>
    </div>

  {%- when 'trust_badges' -%}
    <div class="nectar-trust-badges-row" {{ block.shopify_attributes }}>
      <div class="nectar-trust-badge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Free Shipping</span>
      </div>
      <div class="nectar-trust-badge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Cash on Delivery</span>
      </div>
      <div class="nectar-trust-badge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>100% Vegan Capsule</span>
      </div>
    </div>

  {%- when 'lab_tested' -%}
    <div class="nectar-lab-tested-banner" id="lab-test" {{ block.shopify_attributes }}>
      <div class="nectar-lab-left">
        <div class="nectar-qr-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
          </svg>
        </div>
        <div class="nectar-lab-info">
          <div class="nectar-lab-title">{{ block.settings.title | default: 'Third-party Lab Tested' }}</div>
          <div class="nectar-lab-subtitle">{{ block.settings.subtitle | default: 'Scan the QR on your pack to view the batch report' }}</div>
        </div>
      </div>
      <button type="button" class="nectar-lab-btn" data-view-lab-report>
        {{ block.settings.btn_label | default: 'View Report' }}
      </button>
    </div>

  {%- when 'nutritionist_badge' -%}
    <a href="{{ block.settings.link | default: 'https://wa.me/' }}" class="nectar-nutritionist-pill" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
      <div class="nectar-nutritionist-avatar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </div>
      <div class="nectar-nutritionist-info">
        <div class="nectar-nutritionist-title">{{ block.settings.title | default: 'Talk to a Nutritionist' }}</div>
        <div class="nectar-nutritionist-sub">
          <span class="nectar-online-dot"></span>
          <span>{{ block.settings.subtitle | default: 'Free • Online now' }}</span>
        </div>
      </div>
    </a>

{%- endcase -%}
