{{ 'nf-pdp.css' | asset_url | stylesheet_tag }}
{{ 'nf-pdp-social.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nf-pdp-social.js' | asset_url }}" defer="defer"></script>
{% assign entries = product.metafields.custom.pdp_stories.value %}
{% assign card_count = 0 %}
{% capture cards %}
{% if entries != blank %}
{% for item in entries limit: section.settings.max_items %}{% if item.video.value != blank %}{% assign poster = item.video.value.preview_image | image_url: width: 700 %}{% if item.image.value != blank %}{% assign poster = item.image.value | image_url: width: 700 %}{% endif %}<article class="nf-pdp-story">{{ item.video.value | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '700x', poster: poster }}<div><strong>{{ item.title.value | escape }}</strong><p>{{ item.author.value | escape }}</p></div></article>{% assign card_count = card_count | plus: 1 %}{% endif %}{% endfor %}
{% else %}
{% for block in section.blocks %}
{% if block.settings.product.id == product.id and card_count < section.settings.max_items %}{% if block.settings.video != blank %}{% assign poster = block.settings.video.preview_image | image_url: width: 700 %}{% if block.settings.image != blank %}{% assign poster = block.settings.image | image_url: width: 700 %}{% endif %}<article class="nf-pdp-story" {{ block.shopify_attributes }}>{{ block.settings.video | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '700x', poster: poster }}<div><strong>{{ block.settings.title | escape }}</strong><p>{{ block.settings.author | escape }}</p></div></article>{% assign card_count = card_count | plus: 1 %}{% endif %}{% endif %}
{% endfor %}
{% endif %}
{% endcapture %}
<section id="nf-stories-{{ section.id }}" class="nf-pdp-section nf-pdp-section--stories" style="--nf-section-bg:{{ section.settings.background }};--nf-section-accent:{{ section.settings.accent }};--nf-section-padding:{{ section.settings.padding }}px">
<div class="nf-pdp-shell">
<header class="nf-pdp-section-heading"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.subheading != blank %}<p>{{ section.settings.subheading | escape }}</p>{% endif %}</header>
{% if card_count == 0 and section.settings.show_demo %}<div class="nf-pdp-stories">{% for i in (1..5) %}<article class="nf-pdp-story"><div class="nf-pdp-demo-cover nf-pdp-demo-cover--{{ i }}"><span class="nf-pdp-demo-label">DEMO REEL</span><svg width="120" height="160" viewBox="0 0 120 160" fill="none" aria-hidden="true"><circle cx="60" cy="45" r="27" fill="currentColor"/><path d="M10 160v-20a50 50 0 0 1 100 0v20Z" fill="currentColor"/></svg><span class="nf-pdp-demo-video-note">Video preview placeholder</span></div><div><strong>{% case i %}{% when 1 %}My daily wellness routine{% when 2 %}A closer look at the packaging{% when 3 %}Unboxing Nectarflora{% when 4 %}Simple everyday habits{% else %}Getting started{% endcase %}</strong><p>Sample Customer {{ i }}</p></div></article>{% endfor %}</div>{% elsif card_count > 0 %}<div class="nf-pdp-stories" aria-label="Customer video reviews">{{ cards }}</div>
{% else %}<div class="nf-pdp-social-empty"><p>{{ section.settings.empty_text | escape }}</p></div>{% endif %}


</div></section>
{% schema %}
{"name":"Nectar Stories","settings":[{"type":"paragraph","content":"Product-specific content: connect custom.pdp_stories in the product editor, or add blocks below and select their product. Connected metafields take priority."},{"type":"text","id":"heading","label":"Heading","default":"Loved by our Community"},{"type":"text","id":"subheading","label":"Subheading"},{"type":"color","id":"background","label":"Background","default":"#f6f9f7"},{"type":"color","id":"accent","label":"Accent","default":"#f7c711"},{"type":"range","id":"padding","label":"Vertical padding","min":24,"max":100,"step":4,"unit":"px","default":60},{"type":"range","id":"max_items","label":"Maximum items","min":1,"max":12,"step":1,"default":5},{"type":"text","id":"empty_text","label":"Message when empty","default":"Customer video stories will appear here soon."},{"type":"checkbox","id":"show_demo","label":"Show demo cards when no content","default":true,"info":"Sample content is labelled Demo. Turn off before launch."}],"presets":[{"name":"Nectar Stories"}],"blocks":[{"type":"video","name":"Video review","settings":[{"type":"product","id":"product","label":"Product","info":"Required. This entry only appears on the selected product."},{"type":"video","id":"video","label":"Customer video"},{"type":"image_picker","id":"image","label":"Video cover"},{"type":"text","id":"title","label":"Caption"},{"type":"text","id":"author","label":"Customer name"}]}],"max_blocks":24}
{% endschema %}
