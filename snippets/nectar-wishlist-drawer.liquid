{%- doc -%}
  Nectarflora Slide-Over Wishlist Drawer
  Interactive slide-out panel that manages customer's saved items in real time.
{%- enddoc -%}

<aside id="NectarWishlistDrawer" class="nectar-wishlist-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="My Wishlist">
  <!-- Backdrop Overlay -->
  <div class="nectar-wishlist-drawer__overlay" data-wishlist-close tabindex="-1"></div>

  <!-- Drawer Body -->
  <div class="nectar-wishlist-drawer__panel">
    <!-- Header -->
    <div class="nectar-wishlist-drawer__header">
      <div class="nectar-wishlist-drawer__title">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="#E85D26" stroke="#E85D26" stroke-width="1.8" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        <span>My Wishlist</span>
        <span class="nectar-wishlist-drawer__count" data-drawer-wishlist-count>(0)</span>
      </div>

      <button type="button" class="nectar-wishlist-drawer__close" data-wishlist-close aria-label="Close wishlist drawer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Scrollable Items Container -->
    <div class="nectar-wishlist-drawer__body" data-wishlist-items-container>
      <!-- Populated dynamically via JavaScript -->
    </div>

    <!-- Footer Actions -->
    <div class="nectar-wishlist-drawer__footer" data-wishlist-footer style="display: none;">
      <button type="button" class="nectar-wishlist-drawer__add-all-btn" data-wishlist-add-all>
        Move All to Cart
      </button>
      <button type="button" class="nectar-wishlist-drawer__continue-btn" data-wishlist-close>
        Continue Shopping
      </button>
    </div>
  </div>
</aside>
