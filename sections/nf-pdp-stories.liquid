{{ 'nf-pdp.css' | asset_url | stylesheet_tag }}
{% assign entries = product.metafields.custom.pdp_stories.value %}
{% if entries != blank or request.design_mode %}
<section class="nf-pdp-section nf-pdp-section--stories" style="--nf-section-bg:{{ section.settings.background }};--nf-section-accent:{{ section.settings.accent }};--nf-section-padding:{{ section.settings.padding }}px">
<div class="nf-pdp-shell">
<header class="nf-pdp-section-heading"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.subheading | escape }}</p></header><div class="nf-pdp-stories">{% for item in entries limit: section.settings.max_items %}{% if item.video.value != blank %}<article class="nf-pdp-story">{{ item.video.value | video_tag: controls: true, preload: 'none', image_size: '600x' }}<div><strong>{{ item.title.value | escape }}</strong><p>{{ item.author.value | escape }}</p></div></article>{% endif %}{% endfor %}</div>{% if entries == blank and request.design_mode %}<p class="nf-pdp-editor">Connect product metafield custom.pdp_stories to show this section. Add product-specific entries in the product editor.</p>{% endif %}</div></section>{% endif %}
{% schema %}
{"name": "Nectar Stories", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Loved by our Community"}, {"type": "text", "id": "subheading", "label": "Subheading"}, {"type": "color", "id": "background", "label": "Background", "default": "#f6f9f7"}, {"type": "color", "id": "accent", "label": "Accent", "default": "#f7c711"}, {"type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 60}, {"type": "range", "id": "max_items", "label": "Maximum items", "min": 1, "max": 12, "step": 1, "default": 5}], "presets": [{"name": "Nectar Stories"}]}
{% endschema %}