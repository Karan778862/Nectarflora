{{ 'nf-pdp.css' | asset_url | stylesheet_tag }}
{% assign entries = product.metafields.custom.pdp_usage.value %}
{% if entries != blank or request.design_mode %}
<section class="nf-pdp-section nf-pdp-section--usage" style="--nf-section-bg:{{ section.settings.background }};--nf-section-accent:{{ section.settings.accent }};--nf-section-padding:{{ section.settings.padding }}px">
<div class="nf-pdp-shell">
<header class="nf-pdp-section-heading"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.subheading | escape }}</p></header><div class="nf-pdp-card-grid nf-pdp-card-grid--usage">{% for item in entries limit: section.settings.max_items %}<article class="nf-pdp-content-card"><span class="nf-pdp-content-number">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><h3>{{ item.title.value | escape }}</h3>{% if item.text.value != blank %}<p>{{ item.text.value | escape | newline_to_br }}</p>{% endif %}</article>{% endfor %}</div>{% if entries == blank and request.design_mode %}<p class="nf-pdp-editor">Connect product metafield custom.pdp_usage to show this section. Add product-specific entries in the product editor.</p>{% endif %}</div></section>{% endif %}
{% schema %}
{"name": "Nectar Usage", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "How to Use"}, {"type": "text", "id": "subheading", "label": "Subheading"}, {"type": "color", "id": "background", "label": "Background", "default": "#ffffff"}, {"type": "color", "id": "accent", "label": "Accent", "default": "#f7c711"}, {"type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 60}, {"type": "range", "id": "max_items", "label": "Maximum items", "min": 1, "max": 12, "step": 1, "default": 3}], "presets": [{"name": "Nectar Usage"}]}
{% endschema %}