{%- doc -%}
  Nectarflora Custom Product Media Gallery
  Renders the main product image card with discount badge, floating offer tab, and horizontal thumbnails.
{%- enddoc -%}

{%- liquid
  assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign discount_percent = 9
  if product.compare_at_price > product.price and product.price > 0
    assign discount_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  endif
-%}

<!-- Floating Left Offer Tab -->
<div class="nectar-floating-left-tab" data-floating-tab>
  {{ section.settings.floating_tab_text | default: 'Get 10% OFF' }}
</div>

<div class="nectar-product-gallery" id="NectarGallery-{{ section.id }}">
  <!-- Main Image Card -->
  <div class="nectar-gallery-main-card">
    <div class="nectar-gallery-discount-badge">
      {{ discount_percent }}% OFF
    </div>

    <!-- Wishlist Heart Button -->
    <button
      type="button"
      class="nectar-pdp-wishlist-btn"
      data-nectar-wishlist
      data-product-id="{{ product.id }}"
      data-product-title="{{ product.title | escape }}"
      data-product-url="{{ product.url }}"
      data-product-img="{% if featured_media != blank %}{{ featured_media | image_url: width: 300 }}{% endif %}"
      data-product-price="{{ product.price | money }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      aria-label="Add to wishlist"
      title="Add to wishlist"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>

    {%- if featured_media != blank -%}
      <img
        id="NectarMainImg-{{ section.id }}"
        class="nectar-gallery-main-image"
        src="{{ featured_media | image_url: width: 1000 }}"
        alt="{{ featured_media.alt | default: product.title | escape }}"
        loading="eager"
        width="600"
        height="600"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'nectar-gallery-main-image placeholder-svg' }}
    {%- endif -%}
  </div>

  <!-- Thumbnails Row (Always renders 5 thumbnails matching design) -->
  <div class="nectar-gallery-thumbnails-wrap" data-gallery-thumbs>
    {%- if product.media.size > 1 -%}
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          <button
            type="button"
            class="nectar-thumbnail-btn {% if forloop.first or media.id == featured_media.id %}is-active{% endif %}"
            data-media-id="{{ media.id }}"
            data-full-src="{{ media | image_url: width: 1000 }}"
            aria-label="Image {{ forloop.index }}"
          >
            <img
              src="{{ media | image_url: width: 160 }}"
              alt="{{ media.alt | default: product.title | escape }}"
              loading="lazy"
              width="76"
              height="76"
            >
          </button>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..5) -%}
        <button
          type="button"
          class="nectar-thumbnail-btn {% if forloop.first %}is-active{% endif %}"
          data-media-id="{{ i }}"
          data-full-src="{% if featured_media != blank %}{{ featured_media | image_url: width: 1000 }}{% endif %}"
          aria-label="View {{ i }}"
        >
          {%- if featured_media != blank -%}
            <img
              src="{{ featured_media | image_url: width: 160 }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
              width="76"
              height="76"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </button>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<script>
  (function() {
    function initNectarGallery() {
      const gallery = document.getElementById('NectarGallery-{{ section.id }}');
      if (!gallery) return;

      const mainImg = gallery.querySelector('#NectarMainImg-{{ section.id }}');
      const thumbs = gallery.querySelectorAll('.nectar-thumbnail-btn');
      if (!mainImg || !thumbs.length) return;

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', function() {
          const fullSrc = this.getAttribute('data-full-src');
          if (!fullSrc) return;

          thumbs.forEach(t => t.classList.remove('is-active'));
          this.classList.add('is-active');

          mainImg.style.opacity = '0.3';
          mainImg.style.transform = 'scale(0.98)';
          
          const newImg = new Image();
          newImg.src = fullSrc;
          newImg.onload = function() {
            mainImg.src = fullSrc;
            mainImg.style.opacity = '1';
            mainImg.style.transform = 'scale(1)';
          };
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNectarGallery);
    } else {
      initNectarGallery();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initNectarGallery();
      }
    });
  })();
</script>
