    <!-- Bottom Help Card (Image 1) -->
    <a href="{{ section.settings.help_card_link | default: '/pages/free-consultation' }}" class="nectar-drawer__help-card">
      <span class="nectar-drawer__help-title">{{ section.settings.help_card_title | default: 'Need help choosing?' }}</span>
      <span class="nectar-drawer__help-desc">{{ section.settings.help_card_desc | default: 'Talk to our nutritionist for free.' }}</span>
    </a>
  </div>
</aside>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: 'scheme-1', desktop_menu_type: 'dropdown' -%}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

