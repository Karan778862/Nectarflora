 {"type":"cta","name":"Closing call to action","settings":[{"type":"text","id":"heading","label":"Heading","default":"Find your everyday balance."},{"type":"richtext","id":"text","label":"Text","default":"<p>Explore Nectarflora and find a place to begin your routine.</p>"},{"type":"text","id":"link_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"link","label":"Button link"}]}
 ],
 "presets":[{"name":"Nectarflora About Us","blocks":[{"type":"story"},{"type":"principles"},{"type":"story","settings":{"image_side":"right"}},{"type":"quote"},{"type":"cta"}]}]
}
