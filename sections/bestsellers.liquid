{{ 'nectar-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nectar-card.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="nectar-products-section section-{{ section.id }}-padding {% if section.settings.layout_mobile == 'grid_2' %}nectar-mobile-grid-2{% endif %}">
  <div class="nectar-products-container">
    
    <!-- Section Header -->
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="nectar-section-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="nectar-section-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="nectar-section-subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Products Track / Grid -->
    {%- assign collection = section.settings.collection -%}
    {%- assign has_products = false -%}
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- assign has_products = true -%}
    {%- endif -%}

    <div class="nectar-carousel-wrapper">
      {%- if section.settings.layout_desktop == 'carousel' -%}
        <button type="button" class="nectar-slider-arrow nectar-slider-arrow--prev" data-nectar-slider-prev aria-label="Previous">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      {%- endif -%}

      <div class="{% if section.settings.layout_desktop == 'grid' %}nectar-grid-layout{% else %}nectar-carousel-track{% endif %}">
        {%- if has_products -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            <div class="nectar-carousel-item">
              {% render 'card-product',
                card_product: product,
                section_id: section.id,
                product_view_context: 'collection'
              %}
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Mock Products matching Reference Screenshot 2 -->
          <!-- Product 1: Super Food Plant Protein -->
          <div class="nectar-carousel-item">
            <div class="nectar-card">
              <div class="nectar-card__media-box">
                <span class="nectar-card__badge nectar-card__badge--mostloved">MOST LOVED</span>
                <button type="button" class="nectar-card__wishlist" data-nectar-wishlist data-product-id="mock-bestseller-1" aria-label="Add to wishlist">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </button>
                <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="nectar-card__media-link">
                  <svg class="nectar-card__bottle-svg" viewBox="0 0 100 170" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="35" y="8" width="30" height="20" rx="3" fill="#114736" />
                    <rect x="32" y="24" width="36" height="5" rx="2" fill="#114736" filter="brightness(0.9)" />
                    <rect x="18" y="28" width="64" height="134" rx="16" fill="#114736" />
                    <path d="M22 42C22 35 27 30 34 30H42V158H34C27 158 22 153 22 146V42Z" fill="white" fill-opacity="0.08" />
                    <rect x="23" y="65" width="54" height="52" rx="6" fill="#FFFFFF" />
                    <text x="50" y="95" fill="#0F172A" font-size="9" font-weight="800" font-family="system-ui, sans-serif" text-anchor="middle" letter-spacing="0.5">PROTEIN</text>
                  </svg>
                </a>
              </div>
              <div class="nectar-card__body">
                <div class="nectar-card__rating">
                  <span class="nectar-card__stars">★★★★★</span>
                  <span class="nectar-card__rating-text">4.8 (2.7k reviews)</span>
                </div>
                <h3 class="nectar-card__title"><a href="{{ section.settings.view_all_link | default: '/collections/all' }}">Super Food Plant Protein</a></h3>
