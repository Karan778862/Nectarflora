{{ 'nf-pdp.css' | asset_url | stylesheet_tag }}
{% assign entries = product.metafields.custom.pdp_stats.value %}
{% assign banner_title = product.metafields.custom.pdp_banner_title.value | default: section.settings.heading %}
{% if banner_title != blank %}
<section class="nf-pdp-section nf-pdp-section--delivery" style="--nf-section-bg:{{ section.settings.background }};--nf-section-accent:{{ section.settings.accent }};--nf-section-padding:{{ section.settings.padding }}px"><div class="nf-pdp-shell"><div class="nf-pdp-split"><div><span class="nf-pdp-banner-label">{{ section.settings.label | escape }}</span><h2>{{ banner_title | escape }}</h2><p class="nf-pdp-banner-copy">{{ product.metafields.custom.pdp_banner_text.value | default: section.settings.subheading | escape }}</p><div class="nf-pdp-stats">{% for item in entries %}<div><strong>{{ item.title.value | escape }}</strong><span>{{ item.text.value | escape }}</span></div>{% endfor %}</div></div><div class="nf-pdp-banner-visual">{% if product.metafields.custom.pdp_banner_image.value != blank %}{{ product.metafields.custom.pdp_banner_image.value | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360,540,750,1000', sizes: '(min-width: 750px) 42vw, 90vw' }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360,540,750,1000', sizes: '(min-width: 750px) 42vw, 90vw' }}{% endif %}</div></div>{% if entries == blank and request.design_mode %}<p class="nf-pdp-editor">Connect product metafield custom.pdp_stats to show this section. Add product-specific entries in the product editor.</p>{% endif %}</div></section>{% endif %}
{% schema %}
{"name": "Nectar Delivery", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Targeted nutrition. Everyday wellbeing."}, {"type": "text", "id": "subheading", "label": "Subheading"}, {"type": "color", "id": "background", "label": "Background", "default": "#0c6344"}, {"type": "color", "id": "accent", "label": "Accent", "default": "#f7c711"}, {"type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 60}, {"type": "text", "id": "label", "label": "Top badge", "default": "Everyday wellness, thoughtfully formulated"}], "presets": [{"name": "Nectar Delivery"}]}
{% endschema %}