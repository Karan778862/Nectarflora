{% assign parent_title = parent_link.title | downcase | strip %}
<div class="nectar-megamenu nf-collection-mega"><nf-collection-mega class="nf-mega-layout"><div class="nf-mega-categories" role="tablist" aria-label="{{ parent_link.title | escape }}">
{% assign nf_index = 0 %}{% for item in section.blocks %}{% assign target = item.settings.menu_title | downcase | strip %}{% if item.type == 'nf_mega_category' and target == parent_title %}{% assign nf_index = nf_index | plus: 1 %}<button type="button" id="NfMegaTab-{{ item.id }}" role="tab" aria-controls="NfMegaPanel-{{ item.id }}" aria-selected="{% if nf_index == 1 %}true{% else %}false{% endif %}" tabindex="{% if nf_index == 1 %}0{% else %}-1{% endif %}" data-nf-mega-tab {{ item.shopify_attributes }}>{{ item.settings.title | escape }}<span aria-hidden="true">›</span></button>{% endif %}{% endfor %}
</div><div class="nf-mega-panels">{% assign nf_index = 0 %}{% for item in section.blocks %}{% assign target = item.settings.menu_title | downcase | strip %}{% if item.type == 'nf_mega_category' and target == parent_title %}{% assign nf_index = nf_index | plus: 1 %}{% assign collection = item.settings.collection %}{% assign products = item.settings.products | default: collection.products %}<div id="NfMegaPanel-{{ item.id }}" role="tabpanel" aria-labelledby="NfMegaTab-{{ item.id }}" {% unless nf_index == 1 %}hidden{% endunless %}><div class="nf-mega-product-grid">{% for product in products limit: 8 %}<a class="nf-mega-product" href="{{ product.url }}"><div>{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '180,300,500', sizes: '(max-width: 989px) 40vw, 18vw' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div><h3>{{ product.title | escape }}</h3><p>{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</p></a>{% endfor %}</div>{% assign view_link = item.settings.link | default: collection.url %}{% if view_link != blank %}<a class="nf-mega-view-all" href="{{ view_link }}">View all {{ item.settings.title | escape }} →</a>{% endif %}</div>{% endif %}{% endfor %}</div></nf-collection-mega></div>