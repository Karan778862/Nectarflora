{{ 'nectar-header.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .nectar-announcement-bar {
    background-color: {{ section.settings.bg_color | default: '#0D3B2B' }};
    color: {{ section.settings.text_color | default: '#FFFFFF' }};
  }
  .nectar-announcement-bar__text {
    color: {{ section.settings.text_color | default: '#FFFFFF' }};
  }
  .nectar-announcement-bar__btn {
    color: {{ section.settings.bg_color | default: '#0D3B2B' }};
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="nectar-announcement-bar" role="region" aria-label="Announcement">
    {%- for block in section.blocks -%}
      <div class="nectar-announcement-bar__inner" {{ block.shopify_attributes }}>
        <p class="nectar-announcement-bar__text">
          {{ block.settings.text | escape }}
        </p>
        {%- if block.settings.button_label != blank -%}
          <a href="{{ block.settings.button_link | default: block.settings.link | default: '/collections/all' }}" class="nectar-announcement-bar__btn">
            {{ block.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
      {%- break -%}
    {%- endfor -%}
  </div>
{%- else -%}
  <div class="nectar-announcement-bar" role="region" aria-label="Announcement">
    <div class="nectar-announcement-bar__inner">
      <p class="nectar-announcement-bar__text">
        Free shipping on orders above ₹499 • Extra 10% OFF on your first order
      </p>
      <a href="/collections/all" class="nectar-announcement-bar__btn">
        Shop Now
      </a>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 5,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0D3B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "Free shipping on orders above ₹499 • Extra 10% OFF on your first order"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
