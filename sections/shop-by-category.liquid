{{ 'nectar-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="nectar-products-section section-{{ section.id }}-padding {% if section.settings.layout_mobile == 'grid_2' %}nectar-mobile-grid-2{% endif %}" id="ShopByCategory-{{ section.id }}">
  <div class="nectar-products-container">
    
    <!-- Section Header -->
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="nectar-section-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="nectar-section-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="nectar-section-subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Category Filter Tabs -->
    <div class="nectar-category-tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="nectar-cat-tab {% if forloop.first %}is-active{% endif %}"
          data-nectar-tab
          role="tab"
          id="cat-tab-{{ section.id }}-{{ block.id }}"
          aria-controls="cat-panel-{{ section.id }}-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          data-target="cat-panel-{{ section.id }}-{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          {%- liquid
            assign nf_category_icon = block.settings.icon | default: 'auto'
            assign nf_category_title = block.settings.title | downcase
            if nf_category_icon == 'auto'
              if nf_category_title contains 'best'
                assign nf_category_icon = 'star'
              elsif nf_category_title contains 'skin'
                assign nf_category_icon = 'skin'
              elsif nf_category_title contains 'hair'
                assign nf_category_icon = 'hair'
              elsif nf_category_title contains 'sleep' or nf_category_title contains 'stress'
                assign nf_category_icon = 'moon'
              elsif nf_category_title contains 'liver' or nf_category_title contains 'digestion'
                assign nf_category_icon = 'liver'
              elsif nf_category_title contains 'brain'
                assign nf_category_icon = 'brain'
              elsif nf_category_title contains 'women'
                assign nf_category_icon = 'women'
              else
                assign nf_category_icon = 'grid'
              endif
            endif
          -%}
          <span class="nectar-cat-tab__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              {%- case nf_category_icon -%}
                {%- when 'star' -%}
                  <path d="m12 3 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3L12 17.4l-5.6 2.9 1.1-6.3-4.6-4.4 6.3-.9L12 3Z"/>
                {%- when 'skin' -%}
                  <path d="M8 4C5 5.5 4 8.7 4 12c0 5 3.5 9 8 9s8-4 8-9c0-1.1-.1-2.1-.4-3"/><path d="M8 11h1m5 0h1m-5 5c1.3 1 2.7 1 4 0m4-14 1.2 3.2L22 6l-2.8 1.2L18 10l-1.2-2.8L14 6l2.8-.8L18 2Z"/>
                {%- when 'hair' -%}
                  <path d="M5 21C2 15 3 4 10 3c7-2 12 4 11 11-.3 3-1.1 5-2 7M8 21c-3-5-2-13 2-14m3-1c-3 4-3 10 0 15m3-13c2 4 2 9 0 13"/>
                {%- when 'moon' -%}
                  <path d="M20.8 13.3A9 9 0 0 1 10.7 3.2 9 9 0 1 0 20.8 13.3Z"/><path d="M17 3v4m-2-2h4m2 3v2m-1-1h2"/>
                {%- when 'liver' -%}
                  <path d="M3 10c0-4 4-6 9-6 3 0 5 1 8 1 1 0 2 1 1.5 3L20 13c-.5 2-2 3-4 3h-4l-5 4c-2 1-4 0-4-2v-8Z"/><path d="M12 4c1 4 0 8-3 12m4-7 7-2"/>
                {%- when 'brain' -%}
                  <path d="M12 5a3 3 0 0 0-5-2 4 4 0 0 0-3 5 4 4 0 0 0-1 7 4 4 0 0 0 4 5 3 3 0 0 0 5-2V5Zm0 0a3 3 0 0 1 5-2 4 4 0 0 1 3 5 4 4 0 0 1 1 7 4 4 0 0 1-4 5 3 3 0 0 1-5-2"/><path d="M7 7c0 2 1 3 3 3m-6 3c2-1 4 0 4 2m9-8c0 2-1 3-3 3m6 3c-2-1-4 0-4 2"/>
                {%- when 'women' -%}
                  <circle cx="12" cy="8" r="5"/><path d="M12 13v9m-4-4h8"/>
                {%- else -%}
                  <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
              {%- endcase -%}
            </svg>
          </span>
          <span>{{ block.settings.title | escape }}</span>
        </button>
      {%- endfor -%}
    </div>

    <!-- Tab Panels -->
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      {%- assign has_products = false -%}
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- assign has_products = true -%}
      {%- endif -%}

      <div
        class="nectar-cat-panel {% if forloop.first %}is-active{% endif %}"
        id="cat-panel-{{ section.id }}-{{ block.id }}"
        role="tabpanel"
        aria-labelledby="cat-tab-{{ section.id }}-{{ block.id }}"
      >
        <div class="nectar-carousel-wrapper">
          {%- if section.settings.layout_desktop == 'carousel' -%}
            <button type="button" class="nectar-slider-arrow nectar-slider-arrow--prev" data-nectar-slider-prev aria-label="Previous">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
          {%- endif -%}

          <div class="{% if section.settings.layout_desktop == 'grid' %}nectar-grid-layout{% else %}nectar-carousel-track{% endif %}">
            {%- if has_products -%}
              {%- for product in collection.products limit: section.settings.products_to_show -%}
                <div class="nectar-carousel-item">
                  {% render 'card-product',
                    card_product: product,
                    section_id: section.id,
                    product_view_context: 'collection'
                  %}
                </div>
              {%- endfor -%}
